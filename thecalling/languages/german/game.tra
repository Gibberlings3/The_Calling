/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////                                                  \\\\\
///// Mage - The Cursed Bracers                        \\\\\
/////                                                  \\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\

@1000 = ~Gut, obwohl es größtes Glück war, dass Ihr nicht einen Flügel als Gliedmaße behalten habt. Ihr hattet schon immer einen kleinen Vogel, aber ich nehme an, das zählt nicht.~
@1001 = ~Wir müssen uns bemühen, diese Armschützer zu finden, bevor sie eine andere unglückliche Seele verfluchen. <CHARNAME>, ich werde jede Hilfe brauchen, die ich bekommen kann, und Ihr versteht Euch auf Magie. Könnt Ihr mir helfen?~
@1002 = ~Natürlich helfen wir.~
@1003 = ~Was braucht Ihr von mir?~
@1004 = ~Ich habe Besseres mit meiner Zeit anzufangen.~
@1005 = ~Und am Ende gefiedert sein und Eier legen? Ich denke nicht!~
@1006 = ~Das mag sein, aber ich habe wenig Erfahrung darin, Flüche zu brechen.~
@1007 = ~Dafür gibt es wirklich keinen Anlass *Gack*. Wie Ihr sehen könnt *Gack*, bin ich vollständig *Gack* genesen.~
@1008 = ~Ausgezeichnet. Unsere erste Aufgabe ist es, die Armschützer zu finden. Wenn sie nicht in der Gegend sind, dann fürchte ich, können wir nichts weiter tun. Melicamp!~
@1009 = ~Ja, Meister Thalantyr?~
@1010 = ~Bringt diese Notiz zu Taerom Fuiruim nach Beregost. Wir werden ein Wahrsagungsgerät brauchen, das uns hilft, den Aufenthaltsort der Armschützer zu ergründen.~
@1011 = ~Taerom hat in der Vergangenheit bei solchen Schmuckstücken geholfen, und er kann die mechanische Hälfte dieses Gegenstands herstellen. Helft ihm bei allem, was er braucht.~
@1012 = ~Ich bin auf dem Weg *Gack* nach Beregost.~
@1013 = ~Und Melicamp? Seid vorsichtig, um Mystras willen. Solltet Ihr etwas Seltsames bemerken, kommt sofort hierher zurück.~
@1014 = ~*Gack*~
@1015 = ~Ja, nun ... seltsamer als Gackern.~
@1016 = ~Nun, <CHARNAME>, ich werde Eure Hilfe brauchen, um das Gerät mit Energie zu versorgen. Ich brauche drei verschiedene Edelsteine.~
@1017 = ~Ich überlasse es Eurem Ermessen, welche Edelsteine am besten für die Wahrsagung geeignet wären.~
@1018 = ~Woher soll ich wissen, ob ein Edelstein funktioniert?~
@1019 = ~Wo soll ich mit der Suche beginnen?~
@1020 = ~Habt Ihr irgendwelche Vorlieben für die Edelsteine?~
@1021 = ~In Ordnung, ich werde mit den Edelsteinen zurückkehren.~
@1022 = ~Ihr müsst natürlich Euren eigenen Weg wählen. Und nun, wenn Ihr uns entschuldigt, Melicamp und ich werden diese Aufgabe selbst übernehmen müssen.~
@1023 = ~Der Fluch auf den Armschützern ist ziemlich ungewöhnlich. Ich hatte die Armschützer behalten, statt sie zu zerstören, da ich sie für studierenswert hielt.~
@1024 = ~Die Zerstörung sollte unkompliziert sein, aber das unmittelbare Problem ist ihr Aufenthaltsort. Wenn sie zu weit fort sind, können wir nichts tun.~
@1025 = ~Wenn jemand sie gefunden hat, wird auch das Komplikationen verursachen.~
@1026 = ~Ich werde Euch keine finanzielle Belohnung versprechen, doch aufgrund der ungewöhnlichen Natur der Armschützer werdet Ihr wahrscheinlich viel über Magie lernen, was in Eurer Ausbildung nie behandelt wurde.~
@1027 = ~Ich helfe, wenn auch nur, um meine eigenen Fähigkeiten zu verbessern.~
@1028 = ~Kein Geld, keine Hilfe. Wir gehen.~
@1029 = ~Jeder Edelstein wird funktionieren, aber einige eignen sich besser für die Wahrsagung als andere und werden den Rest der Aufgabe erleichtern. Herauszufinden, welche, ist Eure Aufgabe, <CHARNAME>.~
@1030 = ~Seid nicht albern, Edelsteine gibt es überall. Achtet einfach auf Euren Reisen darauf.~
@1031 = ~Schwarze Perlen eignen sich gut für Wahrsagungsgeräte und werden von Sirinen geschätzt. Abgesehen davon müsst Ihr Eure eigenen Nachforschungen anstellen.~
@1032 = ~Dann wünsche ich Euch viel Erfolg bei Eurer Aufgabe. Guten Tag.~
@1035 = ~Ich habe einige Edelsteine für das Wahrsagungsgerät.~
@1037 = ~Welchen Edelstein möchtet Ihr verwenden?~
@1038 = ~Eigentlich denke ich, ich schaue mich noch etwas um und komme dann wieder.~
@1039 = ~Ich habe meine Meinung geändert. Kann ich stattdessen Eure Waren sehen?~
@1040 = ~Hmm.~
@1041 = ~Eine interessante Wahl.~
@1042 = ~Ein sehr wertvoller Stein. Ihr könntet jedoch feststellen, dass ein hoher Wert ihn nicht unbedingt zur besten Wahl als Zutat macht.~
@1043 = ~Eine ausgezeichnete Wahl.~
@1044 = ~Habt Ihr noch mehr?~
@1045 = ~Ja, haben wir.~
@1046 = ~Das ist erst einmal alles.~
@1047 = ~Haben wir nicht. Aber wo wir schon hier sind, können wir Eure Waren sehen?~
@1048 = ~Nun, Ihr habt Eure Auswahl getroffen; das sind alle drei.~
@1049 = ~Ich glaube nicht, dass Ihr Euch über Eure Wahl Gedanken gemacht habt, aber was geschehen ist, ist geschehen.~
@1050 = ~Ihr hättet es besser machen können - viel besser - aber wir werden uns trotzdem durchwursteln.~
@1051 = ~Insgesamt habt Ihr solide Entscheidungen getroffen.~
@1052 = ~Einige ausgezeichnete Entscheidungen, <CHARNAME>. Ich glaube nicht, dass wir Probleme mit der Wahrsagung haben werden.~
@1053 = ~Ich glaube nicht, dass ich mir drei bessere Edelsteine zum Arbeiten wünschen könnte. Ihr habt Eure Hausaufgaben gemacht.~
@1054 = ~Wir haben nun die Edelsteine, aber ich brauche noch ein Gerät, um sie zu fassen. Könntet Ihr schnell zur Donnerhammer-Schmiede hinübergehen und nach Melicamp sehen?~
@1055 = ~Es wäre ganz seine Art, so eine einfache Aufgabe zu vermasseln.~
@1056 = ~Dann gehen wir Melicamp helfen.~
@1057 = ~Ich bin nicht Euer Laufmädchen! Er wird zurück sein, wenn er zurück ist.~
@1058 = ~Ich bin nicht Euer Laufbursche! Er wird zurück sein, wenn er zurück ist.~
@1059 = ~Sicher, aber können wir zuerst etwas einkaufen?~
@1060 = ~Lebt wohl.~
@1061 = ~Wisst Ihr etwas über schwarze Perlen?~
@1062 = ~Sie werden von Sirinen sehr geschätzt, und die Priesterschaft hier im Tempel hat sie gelegentlich als Opfergaben für den Morgenherrn zu besonderen Anlässen dargebracht.~
@1063 = ~Können wir eine haben?~
@1064 = ~Gebt uns eine!~
@1065 = ~Was würde es kosten, eine von Euch zu bekommen?~
@1066 = ~Interessant. Danke.~
@1067 = ~Das sind Lathander geweihte Gaben! Das kann ich nicht.~
@1068 = ~Bitte, wir versuchen, verfluchte Armschützer für Thalantyr aufzuspüren. Wir brauchen sie, um ein Wahrsagungsgerät zu bauen.~
@1069 = ~Ihr könnt uns entweder die Perlen geben, oder wir nehmen alles hier ... einschließlich Eures Lebens.~
@1070 = ~Vielleicht würde eine Spende ihren Verlust ausgleichen. Auch Gold kann Lathander geweiht werden, nicht wahr?~
@1071 = ~Ich lasse mich nicht von einem dahergelaufenen Dieb einschüchtern! Zu mir, meine Brüder!~
@1072 = ~Kann ich Euch noch mit etwas anderem behilflich sein?~
@1073 = ~Ja, aber ...~
@1074 = ~Die Perlen sind hübsch, aber damit könnt Ihr den Armen und Bedürftigen nicht viel helfen, oder?~
@1075 = ~Ihr habt das Gute gesehen, das wir hier getan haben. Könnt Ihr uns nicht im Gegenzug helfen?~
@1076 = ~Ich bin sicher, wir finden eine für beide Seiten vorteilhafte Vereinbarung.~
@1077 = ~Die Perle war ein Kleinod des Tempels, und es ist sehr aufmerksam von Euch, uns eine neue zu geben.~
@1078 = ~Wir haben auf unseren Reisen eine weitere schwarze Perle gefunden. Wir möchten sie dem Tempel als Ersatz für die Perle stiften, die Ihr uns gegeben habt.~
@1079 = ~Ich denke nicht! Ich werde eine Perle nicht für Gold hergeben, als wäre dies ein gewöhnlicher Laden.~
@1080 = ~Ich nehme an, eine Spende von ... 500 Goldmünzen würde ihren Verlust ausgleichen.~
@1081 = ~Ich habe im Moment nicht so viel Geld.~
@1082 = ~Nein, Euer Preis ist zu hoch.~
@1083 = ~Klingt gut.~
@1084 = ~Dann müsst Ihr eine andere Perle finden. Guten Tag.~
@1085 = ~Ich möchte noch einmal über schwarze Perlen sprechen.~
@1086 = ~In Ordnung.~
@1087 = ~Wir haben darüber gesprochen, dem Tempel Gold im Austausch für eine schwarze Perle zu spenden.~
@1088 = ~Stimmt, Ihr habt dem Tempel in der Vergangenheit geholfen~
@1089 = ~Ich höre von den Stadtbewohnern nichts als Gutes über Eure Taten.~
@1090 = ~Dann könnt Ihr die Perle haben, mit dem Segen des Morgenherrn. Es wird ein Verlust für den Tempel sein, aber es ist besser, sie für das Gute einzusetzen, als sie in einer Vitrine liegen zu lassen.~
@1091 = ~Thalantyr, der Bewohner der Hohen Hecke? Was habt Ihr mit ihm zu schaffen?~
@1092 = ~Sein Lehrling wurde verflucht, und wir versuchen, den Gegenstand zu zerstören, der ihn verflucht hat.~
@1093 = ~Ich habe mit Thalantyr zu tun.~
@1094 = ~Thalantyr möchte ein Wahrsagungsgerät bauen.~
@1095 = ~Thalantyr ist mir bekannt, ebenso wie Eure Gruppe.~
@1096 = ~Ich kann keine Gabe für Lathander herausgeben, es sei denn, Ihr seid bereit zu erörtern, wie sie verwendet werden soll.~
@1097 = ~Thalantyr ist mir bekannt, aber ich kenne Euch nicht gut genug. Vielleicht mit der Zeit, wenn ich Euch besser kenne.~
@1098 = ~Bis dahin muss ich ablehnen. Guten Tag.~
@1099 = ~So sei es.~
@1100 = ~Und ich bin sicher, ich kann mich auf Eure Diskretion in dieser Sache verlassen.~
@1101 = ~Habt Ihr Melicamp gesehen? Magierlehrling, gackert viel?~
@1102 = ~Oh, sicher. Er suchte nach einem Erz, das wir im Moment nicht vorrätig haben, also habe ich ihn zu den Minen von Nashkell geschickt.~
@1103 = ~Eine Freundin von mir, Grace, wollte das besondere Erz besorgen, das er brauchte.~
@1104 = ~Wo war Melicamp noch gleich?~
@1105 = ~Tut mir leid, ich bin zu beschäftigt mit den Problemen in der Mine.~
@1106 = ~Ihr seid Grace? Habt Ihr Melicamp gesehen?~
@1107 = ~Guten Tag.~
@1108 = ~Und Euch ebenfalls.~
@1109 = ~Wo war Melicamp noch gleich?~
@1110 = ~Ich habe Melicamp etwas von dem Erz gegeben, das er brauchte, und er ist in die Mine hinabgestiegen, um den Rest zu holen.~
@1111 = ~Wir alle sind dankbar für Eure Hilfe bei den Minen.~
@1112 = ~*Bwaak* Oh, <GABBER>, Gott sei Dank seid Ihr hier!~
@1113 = ~Es sind die Bergleute, irgendetwas ist *Gack* schiefgelaufen, sie ergeben kaum noch Sinn ... Ich brauche *Gack* Eure Hilfe.~
@1114 = ~Nicht so schnell, Melicamp, und sagt mir, was nicht stimmt.~
@1115 = ~Hört auf zu faseln!~
@1116 = ~*Gack*~
@1117 = ~Nachdem ich mit Grace gesprochen hatte, kam ich *Gack* hierher, um den Rest des Erzes für Taerom zu sammeln.~
@1118 = ~Ich wurde *Gack* von ein paar Kobolden in die Enge getrieben. Ich habe sie abgewehrt, aber nun ja ... *Gack*~
@1119 = ~Ein Teil meiner Magie ist, äh, irgendwie ... *Gack* ... nach hinten losgegangen.~
@1120 = ~Diese beiden Bergleute wurden *Gack* in den Rückschlag verwickelt, und ich glaube, mit ihrem Gedächtnis stimmt *Gack* etwas nicht.~
@1121 = ~Bitte, Ihr müsst *Gack* mir helfen.~
@1122 = ~Ich habe keine Zeit, Euren Schlamassel aufzuräumen! Bringt das selbst in Ordnung, wir sind dann weg.~
@1123 = ~Wirklich, Melicamp, Ihr müsst lernen, Euch zu beherrschen.~
@1124 = ~Was schlagt Ihr vor?~
@1125 = ~Schön, *Gack* danke für nichts. Kommt, Ihr zwei, wir verschwinden.~
@1126 = ~Wer seid Ihr?~
@1127 = ~Häh?~
@1128 = ~Ich treffe *Gack* Euch in der Hohen Hecke wieder, nachdem ich das hier geregelt habe.~
@1129 = ~Ja, für *Gack* Euch ist das leicht zu sagen. Ich höre Euch nicht gackern.~
@1130 = ~Der Gedächtnisverlust scheint nicht allzu schlimm zu sein und könnte sogar von selbst nachlassen.~
@1131 = ~Aber ich fühle mich schrecklich, und ich kann sie nicht so zurücklassen. Vielleicht, wenn wir ihrem Gedächtnis ein wenig auf die Sprünge helfen könnten ...~
@1132 = ~Die anderen Bergleute in der Gegend könnten helfen. Fragt herum und seht, ob Ihr etwas über sie erfahren könnt.~
@1133 = ~Es ist kein großer Plan, aber wir versuchen es.~
@1134 = ~Wir werden die anderen Bergleute befragen und zurückkehren.~
@1135 = ~Ich bleibe hier und passe auf, dass sie nicht fortwandern.~
@1136 = ~Wie bin ich hierhergekommen?~
@1137 = ~Wie funktioniert das?~
@1138 = ~Wo ist dieser große Ochsenkarren?~
@1139 = ~Was ist das für ein schönes Haus?~
@1140 = ~Wohin führt diese Landstraße?~
@1141 = ~Habe ich Recht? ... habe ich Unrecht?~
@1142 = ~Wisst Ihr etwas über Sal oder James? ihr Gedächtnis wurde beschädigt.~
@1143 = ~Kann nicht behaupten, dass ich das wüsste.~
@1144 = ~Tut mir leid, Kumpel, ich weiß gar nichts über gar nichts.~
@1145 = ~Nein, sie haben sich größtenteils für sich gehalten.~
@1146 = ~Unter diesen Bedingungen ist es schwer, viel zu reden.~
@1147 = ~Aber ich erinnere mich, dass James immerzu von seiner Freundin in Beregost erzählt hat. Winnie, wenn ich mich recht entsinne.~
@1148 = ~Die zwei? Nein, tut mir leid.~
@1149 = ~Wer sind Sal und James?~
@1150 = ~Bis vor Kurzem habe ich tiefer in der Mine gearbeitet. Ich kenne die Bergleute auf dieser Ebene nicht so gut.~
@1151 = ~Ja, Sal hat zwei Kinder zu Hause.~
@1152 = ~Zwillinge, genauer gesagt. Robby und Ned.~
@1153 = ~Sal, erinnert Ihr Euch nicht an Eure Zwillingsjungen? Bobby und Ned?~
@1154 = ~Sal, erinnert Ihr Euch nicht an Eure Zwillingsjungen? Bobby und Ted?~
@1155 = ~Sal, erinnert Ihr Euch nicht an Eure Zwillingsjungen? Robby und Ned?~
@1156 = ~Sal, erinnert Ihr Euch nicht an Eure Zwillingsjungen? Robby und Ted?~
@1157 = ~Ich fühle, wie ein Nebel sich lichtet ... ja, meine Jungen ... warte, was?~
@1158 = ~Es sind Robby und Ned! Ich muss sie sofort besuchen.~
@1159 = ~Ich fühle, wie ein Nebel sich lichtet ... ja, meine Jungen ...~
@1160 = ~Robby und Ned! Papa kommt nach Hause!~
@1161 = ~James, versucht, Euch an Eure Liebste in Beregost zu erinnern, Minnie.~
@1162 = ~James, versucht, Euch an Eure Liebste in Beregost zu erinnern, Winnie.~
@1163 = ~James, versucht, Euch an Eure Liebste in Nashkell zu erinnern, Minnie.~
@1164 = ~James, versucht, Euch an Eure Liebste in Nashkell zu erinnern, Winnie.~
@1165 = ~Ja, ich kann ihr Gesicht gerade so erkennen. Ah, mein Schätzchen!~
@1166 = ~Aber es ist Winnie aus Beregost. Danke trotzdem für Eure Hilfe, ich gehe sie besuchen.~
@1167 = ~Winnie! Ich mache mich auf nach Beregost, um Euch wiederzusehen!~
@1168 = ~Schon Erfolg gehabt?~
@1169 = ~Nein, noch nicht.~
@1170 = ~Wir haben die Namen von Sals Zwillingsjungen erfahren.~
@1171 = ~Wir wissen, dass James eine Liebste zu Hause hat.~
@1172 = ~Bei Sal haben wir Erfolg gehabt, aber an James arbeiten wir noch.~
@1173 = ~Bei James haben wir Erfolg gehabt, aber an Sal arbeiten wir noch.~
@1174 = ~Gute Arbeit. Versucht, *Gack* Sals Gedächtnis damit auf die Sprünge zu helfen.~
@1175 = ~Gut gemacht. Seht, ob Ihr *Gack* James' Gedächtnis wiederherstellen könnt.~
@1176 = ~Hey, es *Gack* hat funktioniert! Wenn wir nur noch etwas *Gack* anderes für den anderen finden könnten ...~
@1177 = ~Ich bin sicher, jemand *Gack* hier in der Gegend muss etwas wissen. Fragt weiter herum.~
@1178 = ~Puh, Ihr habt wirklich meine *Gack* Innereien gerettet.~
@1179 = ~Ich mache mich auf den Weg zurück zu *Gack* Thalantyr, bevor noch etwas passiert. Bringt dieses Erz *Gack* zu Taerom für mich.~
@1180 = ~Thalantyr möchte Euch mit einem Wahrsagungsgerät beauftragen. Wir haben etwas Erz für die Aufgabe mitgebracht.~
@1181 = ~Ja, Thalantyr hat eine Anleitung geschickt und erwähnt, dass der junge Melicamp mit dem Erz vorbeikommen würde.~
@1182 = ~Ich vermute, da Ihr hier seid, hat Melicamp es wieder einmal geschafft, bei seiner Aufgabe *räusper* Federn zu lassen?~
@1183 = ~Gebt mir, sagen wir, zwei Tage, dann habe ich das für Thalantyr fertig.~
@1184 = ~Nein, noch nicht. Gebt mir noch etwas Zeit.~
@1185 = ~Hallo <GABBER>. Ich habe das Astrolabium für Thalantyr fertig. Er hat bereits im Voraus bezahlt, also bringt es ihm mit meinen Grüßen zurück.~
@1186 = ~Danke, Taerom, das mache ich.~
@1187 = ~Danke. Wo wir schon hier sind, können wir Eure Waren sehen?~
@1188 = ~Ich wollte nur nachsehen, ob Euer Projekt für Thalantyr schon fertig ist.~
@1189 = ~Willkommen zurück, <GABBER>. Wie ich sehe, bringt Ihr mir auch Taeroms Arbeit.~
@1190 = ~Ich habe die Edelsteine bereits vorbereitet, es ist also nur noch eine Frage, sie in die Fassungen einzusetzen ...~
@1191 = ~Und da wären wir! Sollen wir beginnen?~
@1192 = ~Meister Thalantyr, ich bin *Gack* zurückgekehrt.~
@1193 = ~Melicamp, was hat Euch so lange aufgehalten?~
@1194 = ~Ein paar *Gack* Komplikationen, aber das tut nichts zur Sache. Hier ist Euer neuer *Gack* Wahrsager von Taerom.~
@1195 = ~Ja, fahrt bitte fort.~
@1196 = ~Wie genau soll das funktionieren?~
@1197 = ~Wahrsagung ist selbst unter idealen Bedingungen eine ungenaue Kunst. Da Ihr Euch auf Wahrsagung spezialisiert habt, wisst Ihr das bereits, nicht wahr, <CHARNAME>?~
@1198 = ~Wahrsagung ist selbst unter idealen Bedingungen eine ungenaue Kunst.~
@1199 = ~Viel wird von den Zauberkomponenten abhängen, die wir ausgewählt haben, um das Wahrsagungsgerät mit Energie zu versorgen. Eure Wahl der Edelsteine wird die größte Auswirkung haben.~
@1200 = ~Dann fangen wir an.~
@1201 = ~Und das, wie man so sagt, war es dann.~
@1202 = ~Bah! Wie ich befürchtet habe, war das Gerät nur für einen einzigen Versuch gut.~
@1203 = ~Eure Wahl der Edelsteine war außerordentlich schlecht. Die Armschützer sind noch in der Region, aber ich konnte es nur auf ein Gebiet nördlich von Feuerwein eingrenzen.~
@1204 = ~Eure Wahl der Edelsteine hat die Wirksamkeit des Geräts beeinträchtigt. Die Armschützer sind noch in der Region; sucht nach einer Blume nördlich von Feuerwein.~
@1205 = ~Es verlief ungefähr wie erwartet. Die Armschützer sind, soweit ich es bestimmen kann, in Gullykin.~
@1206 = ~Eure Wahl der Edelsteine war sehr gut. Die Armschützer sind in Gullykin, an einer Halblingsfrau.~
@1207 = ~Ihr hättet keine besseren Edelsteine auswählen können. Ich konnte die Armschützer klar an einer "Iris Cotton" in Gullykin erkennen.~
@1208 = ~Ihr müsst gehen und die Armschützer holen.~
@1209 = ~Wenn jemand sie trägt, dann versucht nicht, sie zu entfernen! Sie werden wahrscheinlich verschwinden, wie es bei Melicamp geschah.~
@1210 = ~Ich kann das nicht genug betonen. Es würde alle unsere bisherigen Bemühungen zunichtemachen.~
@1211 = ~Geht jetzt und kehrt mit den Armschützern zurück.~
@1212 = ~Bitte, Abenteurer, Ihr müsst mir helfen.~
@1213 = ~Meine Frau Iris hat diese Armschützer gefunden, und sie hat sich gerade in ein Eichhörnchen verwandelt!~
@1214 = ~Ich weiß nicht, was ich tun soll!~
@1215 = ~Beruhigt Euch. Wir sind tatsächlich genau deswegen in Gullykin.~
@1216 = ~Sicher, wir können helfen. Gegen Bezahlung.~
@1217 = ~Wie es aussieht, haben wir die verfluchten Armschützer gefunden.~
@1218 = ~Ich bin nur ein armer Halbling, aber Ihr könnt das wenige Gold bekommen, das ich habe, alle 40 Stück, wenn Ihr meine Frau retten könnt.~
@1219 = ~Tut mir leid, aber das wird Euch mehr kosten.~
@1220 = ~40 Gold sind nicht einmal des Nehmens wert. Kommt, Ihr Wicht, wir helfen Euch trotzdem. Behaltet Euer Gold.~
@1221 = ~Rückt es raus.~
@1222 = ~Schön, dann gehe ich wohl einfach zu Alvanhendar.~
@1223 = ~Danke, schätze ich.~
@1224 = ~Nehmt es, nehmt es!~
@1225 = ~Bitte, wie könnt Ihr helfen?~
@1226 = ~Ein Magier nahe Beregost hat nach diesen Armschützern gesucht. Ihr müsst zur Hohen Hecke reisen.~
@1227 = ~Wir können helfen, aber Ihr müsst zur Hohen Hecke westlich von Beregost reisen, um den Magier Thalantyr zu sehen.~
@1228 = ~Ein Magier? Warum kein Priester? Alvanhendar hier im Ort hat in der Vergangenheit solche Dienste geleistet.~
@1229 = ~Diese Armschützer tragen einen ungewöhnlichen Fluch. Alvanhendar könnte den Fluch vielleicht entfernen, aber die Armschützer werden verschwinden.~
@1230 = ~Alvanhendar wird Euch nicht helfen können.~
@1231 = ~Thalantyr studiert diese Armschützer schon seit einiger Zeit und weiß, was mit ihnen zu tun ist.~
@1232 = ~Aber meine Frau wird sicher sein, richtig? Wen kümmert es, wenn die Armschützer verschwinden, das ist doch der ganze Sinn!~
@1233 = ~Aber die Armschützer werden zu einem anderen armen Unschuldigen weiterziehen, wie Eurer Frau.~
@1234 = ~Das stimmt wohl, nehme ich an. Dann geht mal zum Tempel.~
@1235 = ~Vertraut uns, es ist sicherer, einfach Thalantyr aufzusuchen.~
@1236 = ~Daran hatte ich nicht gedacht. Ja, ich möchte nicht, dass jemand anderes das durchmachen muss.~
@1237 = ~Wir treffen Euch dann an der Hohen Hecke.~
@1238 = ~Wie könnt Ihr so sicher sein?~
@1239 = ~Wir ziehen nicht einfach so über die Schwertküste, um diese Armschützer zu zerstören. Vertraut uns.~
@1240 = ~Thalantyr hat den Fluch bereits einmal aufgehoben. Er kann es wieder tun.~
@1241 = ~Nichts ist sicher, aber Thalantyr hat die Sache recht eingehend erforscht.~
@1242 = ~In Ordnung, ich gebe diesem Thalantyr eine Chance.~
@1243 = ~*Fiep*~
@1244 = ~Wir sind heil hier angekommen.~
@1245 = ~Gut, <CHARNAME>, ich hatte gehofft, dass Ihr bald auftaucht.~
@1246 = ~Während Ihr unterwegs wart, um die Cottons zu holen, haben Melicamp und ich einige Nachforschungen angestellt.~
@1247 = ~Wir glauben, einen Weg *Gack* gefunden zu haben, die Armschützer zu entfernen, ohne dass sie verschwinden.~
@1248 = ~Die Beschwörung erfordert jedoch drei Magier, also brauchen wir Eure Hilfe. Herr Cotton, seid Ihr und Eure Frau bereit?~
@1249 = ~So bereit, wie wir sein können, nehme ich an.~
@1250 = ~Gut, dann lasst uns beginnen.~
@1251 = ~Wartet einen Moment, wie lautet die Beschwörung?~
@1252 = ~So ist es recht. Lasst uns beginnen.~
@1253 = ~Ich bin nicht bereit! Ihr habt mir meine Rolle noch nicht erklärt.~
@1254 = ~Halt, was soll ich tun?~
@1255 = ~Es gibt keine feste Beschwörung. Sie wird in drei Versen zu je drei Zeilen gesungen. Ich spreche eine Zeile, dann Melicamp, dann Ihr, und dann wiederholen wir den Vorgang.~
@1256 = ~Ich weiß nicht genau, was ich tun muss, also müsst Ihr und Melicamp folgen und die richtigen Worte singen.~
@1257 = ~Sucht die Muster in den Worten. Ihr seid schließlich ein Magier, und ich erwarte, dass Ihr Eure Intelligenz zeigt.~
@1258 = ~Lasst uns beginnen.~
@1259 = ~Avra boriden covra!~
@1260 = ~Destius ennui *Gack* fristias!~
@1261 = ~Bebeshia kikirt lalaji!~
@1262 = ~Kukuty *Gack* nenerzuo poposh!~
@1263 = ~Lopitaph heuroz zampe!~
@1264 = ~Ephestues solidar *Gack* rillan!~
@1265 = ~Nozika abersto omerth!~
@1266 = ~Amari estus culirn!~
@1267 = ~Gharmas huegas inferita!~
@1268 = ~Tatagh yoyost wiwirshu!~
@1269 = ~Xavros yuca zylenos!~
@1270 = ~Nun der letzte Schliff ...~
@1271 = ~Seht her!~
@1272 = ~Und das, wie man so sagt, war es dann.~
@1273 = ~Ähm. Noch einmal.~
@1274 = ~Entschuldigt das, Frau Cotton, obwohl ich froh bin, den Fluch aufgehoben zu sehen. Ich kann Euch einige Tränke geben, die Eure Schmerzen und Beschwerden lindern.~
@1275 = ~Das war äußerst unangenehm, doch ich danke Euch für Eure Bemühungen.~
@1276 = ~Ehrlich, <CHARNAME>, habt Ihr Euch überhaupt Mühe gegeben? Es ist ein Wunder, dass die arme Frau nicht getötet wurde.~
@1277 = ~Und da die Beschwörung verpfuscht wurde, sind die Armschützer natürlich verschwunden. Melicamp, wir haben noch mehr Arbeit, obwohl wir diesmal unbedingt zuverlässigere Hilfe finden müssen.~
@1278 = ~Natürlich, *Gack* Meister Thalantyr.~
@1279 = ~Nun, danke trotzdem für Eure Bemühungen, <CHARNAME>. Ich hoffe, Ihr habt wenigstens etwas daraus gelernt.~
@1280 = ~Nun, es sieht so aus, als wäre der Fluch zumindest aufgehoben. Wie fühlt Ihr Euch, Frau Cotton?~
@1281 = ~Und es scheint ... ja, bedauerlich. Die Armschützer sind verschwunden. Ihr habt zu viele Zeilen verpatzt, <CHARNAME>.~
@1282 = ~Eure Dienste werden nicht mehr benötigt. Melicamp und ich werden einen weiteren Versuch unternehmen, sie zu finden.~
@1283 = ~Gut gemacht, gut gemacht. Frau Cotton, fühlt sich alles richtig an?~
@1284 = ~Ja, danke! Obwohl mir ein wenig nach Erdnüssen ist ...~
@1285 = ~Das wird *Gack* vielleicht etwas länger dauern, bis es vorübergeht.~
@1286 = ~Und endlich haben wir die Armschützer! Lasst mich eine letzte Anpassung daran vornehmen, um sicherzustellen, dass sie nicht getragen werden können.~
@1287 = ~<CHARNAME>, mit diesem Pulver sollte Taeroms Schmiede heiß genug brennen, um sie endlich zu zerstören.~
@1288 = ~Danke für Eure Hilfe.~
@1289 = ~Thalantyr hat uns hierher geschickt, um in Eurer Schmiede einige verfluchte Armschützer zu zerstören.~
@1290 = ~Was redet er da? Er weiß doch, dass dies nur eine gewöhnliche Schmiede ist.~
@1291 = ~Er hat uns diese Pulver gegeben. Er sagte, es würde Eure Schmiede heiß genug machen, um die Armschützer zu zerstören.~
@1292 = ~Mit diesem Pulver sollte Eure Schmiede heiß genug sein, um den Fluch zu brechen.~
@1293 = ~Nun, bei solchen Dingen hat er gewöhnlich recht. Doch da kommt mir eine Idee ...~
@1294 = ~<CHARNAME>, vielleicht kann ich etwas Neues schmieden, sobald die Armschützer schmelzen. Einmal durchdrungen, behalten Materialien manchmal ihre Kräfte, wenn auch in schwächerer oder veränderter Form, selbst nachdem der Gegenstand zerbrochen oder ausgelaugt ist.~
@1295 = ~Ich kann wirklich nicht vorhersagen, welche magischen Eigenschaften er haben mag, falls überhaupt welche. Er könnte sogar verflucht bleiben.~
@1296 = ~Wenn Ihr das Risiko nicht eingehen wollt, streuen wir die Überreste einfach auf die Kohlen und lassen sie verbrennen.~
@1297 = ~Nach all der Arbeit, sie zu zerstören, gehe ich nicht das Risiko ein, nun einfach einen neuen verfluchten Gegenstand zu schmieden.~
@1298 = ~Was könntet Ihr herstellen?~
@1299 = ~Nein, zerstört sie. Aus ihren Überresten kann nichts Gutes entstehen, egal wie oft sie neu geschmiedet werden.~
@1300 = ~Wir werden das meiste Metall im Feuer der Schmiede und durch Thalantyrs Pulver verlieren, doch ich nehme an, wir werden genug für ein Schmuckstück haben. Ein Amulett vielleicht.~
@1301 = ~Sicher, wir gehen das Risiko ein.~
@1302 = ~Dann feuern wir die Schmiede an.~
@1303 = ~Thalantyrs Pulver hat wie ein Zauber gewirkt!~
@1304 = ~Nun, wir halten diese Schmiede schön heiß, bis wir so viel von diesen Armschützern wie möglich verbrannt haben.~
@1305 = ~Bis dahin benutzen wir die anderen Schmieden, nur für den Fall.~
@1306 = ~Und das hier ist für Euch. Nur für den Fall: Ich würde dringend empfehlen, es zu identifizieren, bevor Ihr es benutzt.~
@1307 = ~Wir können nicht weiter vorgehen, bis Ihr Melicamp findet. Ich habe ihn zu Taerom in die Donnerhammer-Schmiede geschickt.~
@1310 = ~Ich bin froh, dass Melicamp zurückgekehrt ist. Jetzt brauchen wir nur noch Taerom, damit er das mechanische Gerät fertigstellt.~
@1311 = ~Wir können fortfahren, sobald Melicamp aus der Donnerhammer-Schmiede zurückkehrt.~
@1312 = ~Ihr müsst diese Armschützer finden und hierherbringen.~
@1313 = ~Bringt diese Armschützer und das Pulver zu Taerom, damit wir endlich fertig werden.~
@1314 = ~Also ... war es das?~
@1315 = ~Ja, fürchte ich.~
@1316 = ~Oh, Ihr schon wieder. Alvanhendar, das waren die Abenteurer, die ich erwähnt habe.~
@1317 = ~Ich habe alles versucht, was ich kenne. Euer Magierfreund ist jetzt vielleicht ihre einzige Hoffnung.~
@1318 = ~Wir treffen Euch dann an der Hohen Hecke.~
@1319 = ~Thalantyr sollte alles vorbereitet haben. Machen wir uns auf den Weg.~
@1320 = ~Wir müssen uns bemühen, diese Armschützer zu finden, bevor sie eine andere unglückliche Seele verfluchen. <CHARNAME>, ich werde jede Hilfe brauchen, die ich bekommen kann, und Ihr seid Abenteurer. Könnt Ihr mir helfen?~
@1321 = ~Die Beschwörung erfordert jedoch drei Personen, also brauchen wir Eure Hilfe. Herr Cotton, seid Ihr und Eure Frau bereit?~
@1322 = ~Was müssen wir als Nächstes für die Armschützer tun?~
@1323 = ~Die Armschützer sind noch in der Region, aber ich konnte es nur auf ein Gebiet nördlich von Feuerwein eingrenzen.~
@1324 = ~Die Armschützer sind noch in der Region; sucht nach einer Blume nördlich von Feuerwein.~
@1325 = ~Die Armschützer sind, soweit ich es bestimmen kann, in Gullykin.~
@1326 = ~Die Armschützer sind in Gullykin, an einer Halblingsfrau.~
@1327 = ~Ich konnte die Armschützer klar an einer "Iris Cotton" in Gullykin erkennen.~
@1328 = ~Wo habt Ihr gesagt, waren die Armschützer noch gleich?~
@1329 = ~Was soll ich jetzt mit den Armschützern tun?~
@1330 = ~Gibt es sonst noch etwas?~
@1331 = ~Das ist eine prächtige Perle, aber ich fürchte, sie ist für unsere Zwecke noch zu unreif. Ich wäre erfreut, wenn Ihr eine andere findet.~
@1332 = ~Schwarze Perlen müssen ein wenig reifen, bevor sie auf solche Weise verwendet werden können.~
@1333 = ~Wir werden jedoch auf Melicamps Rückkehr warten müssen, bevor wir mit der Wahrsagung beginnen.~
@1334 = ~Wenn man vom Teufel spricht, dann erscheint er. Fangen wir an.~
@1335 = ~Zerstört die verfluchten Armschützer~
@1336 = ~Zerstört die verfluchten Armschützer

Thalantyr bat mich um Hilfe bei der Zerstörung der Armschützer, die Melicamp verflucht haben, aber ich lehnte ab.~
@1337 = ~Zerstört die verfluchten Armschützer

Thalantyr bat mich um Hilfe bei der Zerstörung der Armschützer, die Melicamp verflucht haben. Thalantyr hat uns mit der Konstruktion eines Wahrsagungsgeräts beauftragt. Während Melicamp nach Beregost geht, um mit Taerom zu arbeiten, muss ich drei verschiedene Edelsteine sammeln, um das Gerät mit Energie zu versorgen. Ich muss aufmerksam sein und nach eigenem Ermessen handeln.~
@1338 = ~Zerstört die verfluchten Armschützer

Thalantyr bat mich um Hilfe bei der Zerstörung der Armschützer, die Melicamp verflucht haben. Thalantyr hat uns mit der Konstruktion eines Wahrsagungsgeräts beauftragt. Während Melicamp nach Beregost geht, um mit Taerom zu arbeiten, muss ich drei Edelsteine sammeln, um das Gerät mit Energie zu versorgen. Thalantyr erwähnte, dass schwarze Perlen nützlich sind, aber ansonsten muss ich aufmerksam sein und nach eigenem Ermessen handeln.~
@1339 = ~Zerstört die verfluchten Armschützer

Ich habe Thalantyr drei Edelsteine geliefert, um das Wahrsagungsgerät mit Energie zu versorgen. Melicamp ist jedoch noch nicht von seinem Besuch bei Taerom in Beregost zurückgekehrt, und Thalantyr hat mich gebeten, nach seinem Fortschritt zu sehen.~
@1340 = ~Zerstört die verfluchten Armschützer

Ich habe Thalantyr drei Edelsteine geliefert, um das Wahrsagungsgerät mit Energie zu versorgen. Melicamp ist noch nicht von seinem Besuch bei Taerom in Beregost zurückgekehrt, aber ich kann keine Zeit verschwenden, um nach ihm zu sehen. Er wird irgendwann zurückkehren.~
@1341 = ~Zerstört die verfluchten Armschützer

Taerom hatte das benötigte Erz für das Wahrsagungsgerät nicht, also schickte er Melicamp zu seinem Kontakt Grace in die Minen von Nashkell. Ich sollte dort nach ihm sehen.~
@1342 = ~Zerstört die verfluchten Armschützer

Grace stattete Melicamp mit einem Teil des benötigten Erzes aus. Es war nicht genug, also ist Melicamp in die Mine hinabgestiegen, um mehr zu finden.~
@1343 = ~Zerstört die verfluchten Armschützer

Melicamps Magie ist nach hinten losgegangen und hat die Erinnerungen zweier Bergleute zerstört. Ich weigerte mich, seinen Schlamassel auszubügeln, also ging er mit den Bergleuten fort, um zu versuchen, ihnen zu helfen. Ich bin sicher, er wird irgendwann den Weg zurück zu Thalantyr finden.~
@1344 = ~Zerstört die verfluchten Armschützer

Melicamps Magie ist nach hinten losgegangen und hat die Erinnerungen zweier Bergleute beschädigt, Sal und James. Melicamp schlägt vor, mit den anderen Bergleuten zu sprechen. Wenn wir einige Einzelheiten über sie erfahren können, können wir vielleicht ihr Gedächtnis auffrischen und wiederherstellen, was fehlt.~
@1345 = ~Zerstört die verfluchten Armschützer

Ich habe dem Bergmann Sal geholfen, indem ich ihn an seine Zwillingsjungen erinnerte.~
@1346 = ~Zerstört die verfluchten Armschützer

Ich habe dem Bergmann James geholfen, indem ich ihn an seine Liebste in Beregost erinnerte.~
@1347 = ~Zerstört die verfluchten Armschützer

Die Bergleute wurden gerettet, und Melicamp hat mir das benötigte Erz gegeben. Während er sich auf den Rückweg zu Thalantyr macht, bringe ich das Erz zu Taerom, damit er das Wahrsagungsgerät schmieden kann.~
@1348 = ~Zerstört die verfluchten Armschützer

Ich habe das Erz Taerom gegeben, damit er das Gerät schmiedet. Er sagt, es wird in zwei Tagen fertig sein.~
@1349 = ~Zerstört die verfluchten Armschützer

Taerom hat das Wahrsagungsgerät erfolgreich geschmiedet und es mir gegeben. Ich sollte zur Hohen Hecke zurückkehren, damit Thalantyr nach den Armschützern suchen kann.~
@1350 = ~Zerstört die verfluchten Armschützer

Thalantyr hat das Wahrsagungsgerät benutzt, um die Armschützer zu lokalisieren. Meine Auswahl der Edelsteine war jedoch so schlecht, dass wir ihren Aufenthaltsort nur auf ein Gebiet nördlich von Feuerwein eingrenzen konnten.~
@1351 = ~Zerstört die verfluchten Armschützer

Thalantyr hat das Wahrsagungsgerät benutzt, um die Armschützer zu lokalisieren. Meine Auswahl der Edelsteine war jedoch schlecht, und wir konnten ihren Aufenthaltsort nur auf ein Gebiet nördlich von Feuerwein eingrenzen. Thalantyr sagt, wir sollen nach einer Blume suchen.~
@1352 = ~Zerstört die verfluchten Armschützer

Thalantyr hat das Wahrsagungsgerät benutzt, um die Armschützer zu lokalisieren. Meine Auswahl der Edelsteine war ausreichend, und wir konnten den Aufenthaltsort auf Gullykin eingrenzen.~
@1353 = ~Zerstört die verfluchten Armschützer

Thalantyr hat das Wahrsagungsgerät benutzt, um die Armschützer zu lokalisieren. Meine Auswahl der Edelsteine war gut, und wir konnten die Armschützer an einer in Gullykin lebenden Halblingsfrau ausfindig machen.~
@1354 = ~Zerstört die verfluchten Armschützer

Thalantyr hat das Wahrsagungsgerät benutzt, um die Armschützer zu lokalisieren. Meine Auswahl der Edelsteine war ausgezeichnet, und wir konnten die Armschützer an einer in Gullykin lebenden Halblingsfrau namens Iris Cotton ausfindig machen.~
@1355 = ~Zerstört die verfluchten Armschützer

Ich habe die verfluchten Armschützer endlich gefunden! Wir trafen Largo Cotton in Gullykin und entdeckten, dass seine Frau Iris in ein Eichhörnchen verwandelt wurde. Largo möchte sehen, ob der örtliche Priester Alvanhendar helfen kann, bevor sie zur Hohen Hecke reisen. Ich sollte sie am örtlichen Tempel hier in Gullykin treffen.~
@1356 = ~Zerstört die verfluchten Armschützer

Ich habe die verfluchten Armschützer endlich gefunden! Wir trafen Largo Cotton in Gullykin und entdeckten, dass seine Frau Iris in ein Eichhörnchen verwandelt wurde. Ich habe Largo überzeugt, zur Hohen Hecke zu reisen und mit Thalantyr zu sprechen. Ich sollte ebenfalls dorthin reisen.~
@1357 = ~Zerstört die verfluchten Armschützer

Leider konnte der örtliche Kleriker Alvanhendar Iris Cotton bei dem Fluch der Armschützer nicht helfen. Die Cottons reisen zur Hohen Hecke, um Thalantyr zu treffen. Ich sollte ebenfalls dorthin reisen.~
@1358 = ~Zerstört die verfluchten Armschützer

Thalantyr, Melicamp und ich konnten Iris Cotton von den verfluchten Armschützern befreien. Leider habe ich meinen Teil der Beschwörung nicht richtig hinbekommen: Iris wurde verletzt, und die Armschützer sind verschwunden.

Thalantyr hat mir für meine Bemühungen gedankt, und mein Teil daran ist getan. Thalantyr und Melicamp werden versuchen, die Armschützer ohne mich zu finden.~
@1359 = ~Zerstört die verfluchten Armschützer

Thalantyr, Melicamp und ich konnten Iris Cotton von den verfluchten Armschützern befreien. Ich habe einen Teil der Beschwörung verpatzt, doch Iris hat es mit nur leichten Beschwerden überstanden, die Armschützer sind jedoch verschwunden.

Thalantyr hat mir für meine Bemühungen gedankt, und mein Teil daran ist getan. Thalantyr und Melicamp werden versuchen, die Armschützer ohne mich zu finden.~
@1360 = ~Zerstört die verfluchten Armschützer

Thalantyr, Melicamp und ich konnten Iris Cotton von den verfluchten Armschützern befreien. Die Beschwörung war gut genug, dass Iris ohne Nebenwirkungen davonkam.

Ich sollte die Armschützer zusammen mit einem besonderen Pulver, das Thalantyr bereitgestellt hat, zu Taerom nach Beregost bringen. Das Pulver wird dafür sorgen, dass seine Schmiede heiß genug brennt, um die Armschützer ein für alle Mal zu zerstören.~
@1361 = ~Zerstört die verfluchten Armschützer

Thalantyr, Melicamp und ich konnten Iris Cotton mit einer perfekten Beschwörung von den verfluchten Armschützern befreien.

Ich sollte die Armschützer zusammen mit einem besonderen Pulver, das Thalantyr bereitgestellt hat, zu Taerom nach Beregost bringen. Das Pulver wird dafür sorgen, dass seine Schmiede heiß genug brennt, um die Armschützer ein für alle Mal zu zerstören.~
@1362 = ~Zerstört die verfluchten Armschützer

Die Armschützer sind endlich zerstört und in der magisch verstärkten Hitze von Taeroms Schmiede zu Schlacke geschmolzen. Taerom bot an, zu versuchen, die Überreste zu einem neuen magischen Gegenstand zu schmieden, aber da sie aus verfluchtem Material stammen, wollte ich das Risiko nicht eingehen.~
@1363 = ~Zerstört die verfluchten Armschützer

Die Armschützer sind endlich zerstört. Die magisch verstärkte Hitze von Taeroms Schmiede hat sie vernichtet, und Taerom konnte aus ihren Überresten einen neuen Gegenstand schmieden. Ob der neue Gegenstand einen Teil ihrer ursprünglichen verfluchten Energie behält oder stattdessen nützlich ist, bleibt abzuwarten.~
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////                                                  \\\\\
///// Fighter - Expanded Gnoll Stronghold              \\\\\
/////                                                  \\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\

@10000 = ~Erweiterte Gnollfestung~
@10001 = ~Argh, ich habe Euch kommen sehen ... Nun werde ich Euch fallen sehen! Argh! Auuu!~
@10002 = ~Gnoll-Schwächling~
@10003 = ~Schamane Sirkhr~
@10004 = ~Siechender Gnoll~
@10005 = ~Häuptling Hvalanya~
@10006 = ~Wachhund Purkht~
@10007 = ~Hauptmann Stilind~
@10008 = ~Amnischer Soldat~
@10009 = ~Amnischer Späher Manlytoe~
@10010 = ~Kalvranalan~
@10011 = ~Stab der ätzenden Gedanken +1~
@10012 = ~Gürtel der Vorzeichen~
@10013 = ~Dieser ungewöhnliche Gürtel wurde für einen Assassinen namens Mudbone gefertigt. Er war auf die Tötung von Priestern spezialisiert, insbesondere solcher, die jenen als Hindernis galten, die wenig Respekt vor gläubigen Menschen hatten. Der Gürtel sieht gut verarbeitet aus. Er muss aus hochwertigen Materialien gefertigt worden sein.

EIGENSCHAFTEN:

Schaden: +2 Bonus gegen Kleriker
Magieresistenz: 2%

Gewicht: 2~
@10015 = ~Kettenhemd des primitiven Respekts +1~
@10016 = ~An diesem Kettenpanzer ist etwas wirklich Rohes und Primitives, doch Ihr spürt magische Energie in seinen Gliedern. Er sollte seinen Träger im Kampf schützen können, und die Magie könnte sich in der Wildnis als nützlich erweisen. Allerdings hat die Rüstung einen seltsamen Geruch, der Euch an Hundefell erinnert.

EIGENSCHAFTEN:

Ausgerüstete Fähigkeiten: Rüstungsklasse gegen Tiere: +2
Ausgerüstete Fähigkeiten: -1 Charisma
Rüstungsklasse: 4
Gewicht: 20
Benötigt: Stärke 8
Kann nicht verwendet werden von:
 Druide 
 Magier 
 Dieb~
@10017 = ~Schlupfwinkel~
@10018 = ~Umhang der Formstabilität~
@10019 = ~Dieser Umhang wurde aus verzaubertem Stoff gefertigt, der sich als recht nützlich erweisen dürfte, wenn man Gegner wie Basilisken bekämpft, da er seinen Träger vor deren tödlichem Blick schützt.

EIGENSCHAFTEN:

Spezielle Fähigkeiten: +4 Bonus auf alle Rettungswürfe gegen Verwandlung~
@10020 = ~Torbogen~
@10021 = ~Amulett des dunklen Unglücks~
@10022 = ~Dieses Amulett wurde mit dunkler Magie verflucht. Wer es trägt, wird von Unglück verfolgt, und auf Reisen oder im Abenteuer ... kann Glück über Leben und Tod entscheiden.

EIGENSCHAFTEN:

Glück: um 1 verringert
Speziell: kann nur durch den Zauber "Fluch brechen" entfernt werden~
@10023 = ~Tempel des Biests der Metzelei~
@10024 = ~Pfeil des zerbrochenen Geistes +1~
@10025 = ~Dieser Pfeil sieht zerbrochen aus, doch selbst wenn Ihr eine Hälfte haltet, schwebt die andere direkt daneben. Auch wenn er nicht wirklich mächtig ist, kann er nützlich sein, wenn einem Abenteurer die normalen Pfeile ausgehen.

EIGENSCHAFTEN:

Kehrt zum Träger zurück, wenn abgeschossen

Speziell: Schlägt als +1-Waffe zu
Schaden: 1
Schadensart: Geschoss (Stich)
Gewicht: 0
Schusswaffe: Bogen
Kann nicht verwendet werden von:
 Kleriker
 Druide
 Magier~
@10026 = ~Innenbereich der Gnollfestung~
@10027 = ~Dieser Stab wurde früher von einem Gnoll-Schamanen aus der Gnollfestung an der Schwertküste benutzt.

Es ist schwer zu sagen, wer ihn erschaffen hat. Er fühlt sich recht roh an, und obwohl seine Macht nicht die größte ist, gibt es sicherlich Situationen, in denen er verwendet werden kann.

EIGENSCHAFTEN:

Spezielle Fähigkeiten: Kann einmal pro Tag Melfs Säurepfeil wirken
ETW0: +1
Schaden: 1W6+1
Schadensart: Wucht
Initiativefaktor: 3
Fertigkeit: Kampfstab
Typ: 2-händig
Benötigt: Stärke 5~
@10029 = ~Umhang des Regenten-Kriegers~
@10030 = ~Dieser purpurne Umhang hat eine recht majestätische Aura, und man glaubt, dass er für einen König geschaffen wurde, aber ... die Legende verrät nicht, für welchen. Er soll nicht nur seinen Träger schützen, sondern auch alle um ihn herum glauben lassen, dass jedes seiner Worte wahr ist, und sie dazu bringen, ihn zu verehren.

Ihr habt diesen Umhang als Zeichen des Vertrauens und der Dankbarkeit für die Sicherung der Gnollfestung erhalten.

EIGENSCHAFTEN:

Rüstungsklasse: +1 Bonus
Rettungswurf: +1 Bonus
ETW0: +1 gegen Kämpfer, Mönche, Paladine, Waldläufer
Schaden: +1 gegen Kämpfer, Mönche, Paladine, Waldläufer
Charisma: Einmal pro Tag 1W4 Charisma für zehn Runden (nur Kämpfer)
Gewicht: 3~
@10031 = ~Ritualbuch der Gnollen~
@10032 = ~Dieses Buch beschreibt Rituale: einige, um die natürliche Energie zu zähmen, und einige, um Yeenoghu, das Biest der Metzelei, zu erfreuen. Ein Ritual ist besonders morbide und beschreibt die Verbrennung menschlicher Schädel.~
@10033 = ~Medizinische Vorräte~
@10034 = ~Diese Tasche ist mit medizinischen Vorräten gefüllt.~
@10035 = ~Fleisch~
@10036 = ~Yeenoghus brennendes Fleisch~
@10037 = ~Dieses brennende Fleisch ist tatsächlich Yeenoghus brennendes Fleisch. Wer es verzehrt, mag den besonderen Segen des Prinzen der Gnollen erhalten, doch er hat seinen Preis.

EIGENSCHAFTEN:

Speziell: Senkt bei Verzehr das Charisma um 1, gewährt aber +2 Schaden gegen gute Kreaturen. Der Bonus ist dauerhaft.

Gewicht: 2~
@10038 = ~Primitiver Schlüssel~
@10039 = ~Ihr habt diesen primitiven Schlüssel in der Gnollfestung gefunden. Er muss dort etwas öffnen.~
@10040 = ~Ich wurde gebeten, Euch auszurichten, dass "die Hoffnung durch die Straßen Athkatlas wandelt".~
@10041 = ~Ahh, kühne Abenteurer an unserer Tür. Helm schützt die gesamten Reiche, und seine Diener stehen zu Eurer Verfügung. Der Wachsame ist bereit, Euren Gebrechen Abhilfe zu schaffen und somit den unnachgiebigen Blick des Großen Anführers abzulenken – natürlich für eine angemessene Gabe. Wir wollen uns doch gegenseitig unseren guten Willen beweisen, Ihr versteht schon.~
@10042 = ~Welche Art von Diensten bietet Ihr an?~
@10043 = ~Ich brauche im Moment nichts von Euch. Auf Wiedersehen.~
@10044 = ~Hmm? Ich verstehe, dass Ihr das nicht ohne Grund sagt. Ihr seid wegen der Vorräte hier, die ich für den Notfall vorbereiten sollte, richtig?~
@10045 = ~Ja.~
@10046 = ~Nun, was glaubt Ihr?~
@10047 = ~Es ist nicht meine Aufgabe, Euch zu befragen, sondern Euch dies zu geben. Nehmt diese Truhe und bringt sie zu denen, die sie brauchen.~
@10048 = ~Wisset, dass Helm über Euch wachen wird.~
@10049 = ~Argh! Wir ... haben Gäste ... Grr! Törichte Dinger! Ihr wisst, dass man Häuptling Hvalanya nicht stört?!~
@10050 = ~Nein, ich glaube nicht, dass das auf meinem Weg hierher jemand erwähnt hat. Aber sie waren alle damit beschäftigt, tot zu sein.~
@10051 = ~Es tut mir leid, Hvalanya, aber ich kann nicht zulassen, dass Ihr die Leute der Schwertküste angreift. Ich bin hier, um Euch aufzuhalten.~
@10052 = ~Hahahaha! Ihr seid ein lustiges kleines Ding! Ich und meine Jungs werden Euch zeigen, dass man Häuptling Hvalanya nicht einfach anbellt und erwartet, hier heil herauszukommen! Auuu!~
@10053 = ~Ich grüße Euch, Freund.~
@10054 = ~Ihr! Argh, Euresgleichen weiß nicht, wann man Gnolle in Ruhe lassen sollte ...! Böse Alte, verhasst von den starken Gnollen, sogar vom Häuptling.~
@10055 = ~Wer seid Ihr?~
@10056 = ~Na, na. Das ist ja eine ganz schöne Sammlung, die Ihr da habt. Beeindruckend für jemanden Euresgleichen.~
@10057 = ~Jetzt fragt Ihr ...?! Nachdem Ihr alte Gnolle getötet oder verletzt habt? Argh!~
@10058 = ~Das ist alles mein ...!~
@10059 = ~Alte Gnolle verdienen Respekt und wir ... haben diesen Ort eingenommen. Und diesen Raum, in dem ein alter Priester lebte. Jetzt ist er tot. Jetzt nutze ich diesen Ort.~
@10060 = ~Viele der anderen Gnolle behandeln mich und die alten und schwächeren Gnolle wie kranke Hunde! Sie lachen! Pinkeln uns an! Aber obwohl wir unter ihrem Heim leben, kennen wir unseren Wert ... Wir kennen unsere Stärke!~
@10061 = ~Wir preisen Yeenoghu! Und wir töten. Und wir essen. Selbst wenn wir unsere eigenen essen müssen ... aber Ihr ...~
@10062 = ~Ihr seid vielleicht viel leckerer ... Wir werden heute schmausen.~
@10063 = ~Seid vorsichtig, Abenteurer. Das ist ein gefährlicher Ort ... Ich ... ich habe die meisten meiner Leute an Monster verloren, die die nahe gelegene Festung besetzen. Ihr seht aus wie ein guter Krieger, <PRO_RACE>, aber diese Kreaturen hier sind wild!~
@10064 = ~Was ist mit den Leuten geschehen, von denen Ihr sprecht? Sind sie tot?~
@10065 = ~Sie müssen schwach gewesen sein, wenn sie wegen irgendwelcher rohen Kreaturen gestorben sind.~
@10066 = ~Es waren gute Männer und Frauen ... Wir kamen hierher, um diesen Ort zu beanspruchen. Er sollte der amnischen Armee gehören, nicht diesen Kreaturen. Wir wurden von Athkatla hierher geschickt, um den Ort zu erkunden und zu sehen, ob eine kleine Gruppe die Gnolle still und leise ausschalten und ihn zu einem Operationspunkt machen könnte.~
@10067 = ~Wir gerieten in eine Falle. Sie warfen Felsbrocken auf uns, andere wurden mit ihren Hellebarden und Klingen getötet.~
@10068 = ~Minsk fürchtet diese Kreaturen nicht. Sie sind böse, und dem Bösen wird irgendwann immer ordentlich der Hintern versohlt! Höchstwahrscheinlich von Minsk und Boo. *Quiek*~
@10069 = ~Nun, natürlich scheitern die Unvorbereiteten immer. (Deshalb braucht man immer einen ordentlichen Plan. Und ein paar Trottel, die als Kanonenfutter dienen können.)~
@10070 = ~A-arme Leute. Ich k-kann mir nur vorstellen, wie schwer es sich anfühlt, v-vertraute Freunde zu verlieren ...~
@10071 = ~Ich bin der Einzige, der das überlebt hat. Aber ... Ihr seht stark aus. Vielleicht könntet Ihr tatsächlich überleben.~
@10072 = ~Vielleicht können wir doch noch etwas dagegen tun. Da wir schon hier sind, können wir Euch vielleicht helfen und Eure Leute rächen.~
@10073 = ~Nun, Ihr Armen. Ich nehme an, Ihr solltet nach Hause zurückkehren und dem Gott, dem Ihr dient, dafür danken, dass er Euch Euer erbärmliches Leben geschenkt hat. Und nun entschuldigt mich, ich muss gehen.~
@10074 = ~Ihr wollt mir helfen? Das ... das wäre wirklich wunderbar.~
@10075 = ~Was ich herausgefunden habe, ist, dass es hier zwei Gruppen gibt. Die schwächeren Gnolle, die alten, und die, die verletzt wurden und nicht mehr so nützlich sind wie früher. Sie werden von einem Schamanen angeführt.~
@10076 = ~Aber es gibt auch eine andere Gruppe der jüngeren, stärkeren Gnolle. Sie werden von ihrem Häuptling angeführt. Einem weiblichen Gnoll. Sie nennen sie "Häuptling Hvalanya". Sie soll recht grausam sein. Zumindest haben wir das daraus geschlossen, wie sie über sie sprechen.~
@10077 = ~Beide müssen gestoppt werden, wenn wir diesen Ort übernehmen wollen. Aber es gibt noch einen Dritten, der ebenfalls gestoppt werden sollte ...~
@10078 = ~Einen Dritten?~
@10079 = ~Wer ist der Dritte? Sagt es mir endlich!~
@10080 = ~Der Dritte ist nicht gerade ein Anführer, sondern eine Art ... Wachhund. Er steht normalerweise auf einem der Türme. Ich bin mir allerdings nicht sicher, auf welchem.~
@10081 = ~Hmm, aber es wäre vielleicht eine gute Idee, ihn ebenfalls zu erledigen. Also, zwei Anführer und ein Wachhund.~
@10082 = ~Das ist alles? Hah! Die sind tot, bevor Ihr "meine ganze Truppe ist gestorben" sagen könnt.~
@10083 = ~Genau.~
@10084 = ~Im Ernst? Ihr Tod ist eine Tragödie. Macht Euch nicht darüber lustig.~
@10085 = ~Wenn diese drei Gnolle getötet werden, sollten die anderen fliehen oder sich verstecken. Ohne die wichtigsten Mitglieder ihres Rudels oder Clans oder wie auch immer sie sich nennen, sind sie keine echte Bedrohung mehr!~
@10086 = ~Seid Ihr sicher, dass Ihr das bewältigen könnt? Ihr seht stark aus, aber ich muss Euch das einfach fragen. Es sind verdammt viele.~
@10087 = ~Keine Sorge. Ich weiß, was ich tue.~
@10088 = ~Das werden wir erst wissen, wenn ich es versucht habe.~
@10089 = ~Wenn ich entscheide, dass es zu viele sind, laufe ich einfach weg.~
@10090 = ~Richtig. Wenn Ihr glaubt, eine Chance gegen sie zu haben, und wenn Ihr es schafft, diese drei zu töten, dann kommt bitte zu mir zurück und lasst mich wissen, dass das Leben meiner Freunde nicht umsonst geopfert wurde.~
@10091 = ~Ihr seid ein grausamer Mensch. Vielleicht werdet Ihr mit der Zeit verstehen, dass ... dass dieser Ort vom Einfluss dieser Kreaturen befreit werden muss. Wenn ja, kommt dann zu mir zurück.~
@10092 = ~Ihr schon wieder? Seid Ihr hier, um Euch über mich und meine toten Freunde lustig zu machen.~
@10093 = ~Erinnert mich: Was ist mit Euren Freunden geschehen?~
@10094 = ~Ihr und sie sind mir gleichgültig. Auf Wiedersehen.~
@10095 = ~Ah, Ihr kommt zurück. Habt Ihr es geschafft, die Gnoll-Anführer und den Wachhund zu erledigen?~
@10096 = ~Ja. Sie sind alle tot. Es sieht so aus, als wären die Gnolle größtenteils verschwunden, aber hier und da könnte noch der eine oder andere sein. Ohne Anführer sollten sie leichte Ziele sein.~
@10097 = ~Ich arbeite noch daran.~
@10098 = ~Ihr ... Ihr habt es wirklich geschafft! Ich wünschte, meine Freunde wären hier, um das zu hören. Aber ich möchte glauben, dass sie Teil davon sind. Teil dieses Sieges. Doch die Arbeit ist noch nicht getan. Es gibt noch viel zu tun.~
@10099 = ~Lasst uns tiefer in der Festung treffen, am oberen Ende der Treppe. Dort sollten wir unsere Mission fortsetzen. Wenn Ihr interessiert seid. Aber lasst mich Euch sagen, es wird Eure Zeit wert sein, mein Kriegerfreund.~
@10100 = ~Hmm. Alles sieht gut aus ... Nun, ich habe es geschafft, von dem Turm aus ein Signal zu senden, wie ich es den Spähern südlich von hier angekündigt hatte. Ich denke, sie werden mir ein paar weitere Leute schicken, aber ich will nicht, dass wieder etwas schiefgeht.~
@10101 = ~Und ich nehme an, Ihr braucht meine Hilfe, um zu verhindern, dass so etwas noch einmal geschieht, richtig? Sagt mir, wie ich helfen kann.~
@10102 = ~Tut mir leid, aber ich habe keine Zeit, Euch zu helfen.~
@10103 = ~In der Nähe gibt es eine Bergbaustadt. Nashkell ist ihr Name. Dort gibt es einen Tempel, und ich möchte, dass Ihr dorthin geht und mir einige medizinische Vorräte bringt. Der Priester wurde informiert, dass wir möglicherweise Hilfe brauchen könnten, wenn ich mich nicht irre. Schade, dass wir nicht vorher mit ihm gesprochen haben, bevor ich meine Freunde verlor, vielleicht hätten diese etwas genützt – nein. Das hätte die Tragödie auch nicht verhindert. Es tut mir leid, sie sind mir immer noch im Kopf.~
@10104 = ~Jetzt könnten wir diese Vorräte brauchen. Die Festung ist vielleicht gesäubert, aber wer weiß, vielleicht streifen noch mehr dieser Kreaturen durch diese Berge und Pfade. Während wir also darauf warten, dass mehr Männer und Frauen hierher kommen, um mir zu helfen, könntet Ihr nach Nashkell gehen und den Priester um die Vorräte bitten.~
@10105 = ~Und wird der Kleriker mir einfach glauben, dass Ihr mich geschickt habt?~
@10106 = ~Das klingt nach einer leichten Aufgabe. Ich weiß, wo Nashkell liegt.~
@10107 = ~Tut mir leid, aber nein. Ich habe keine Zeit dafür. Eigentlich muss ich gehen. Auf Wiedersehen.~
@10108 = ~Ihr müsst nur sagen: "Die Hoffnung wandelt durch die Straßen Athkatlas." Dann weiß er, dass Ihr wegen der Vorräte geschickt wurdet.~
@10109 = ~Klingt einfach.~
@10110 = ~Klingt einfach. Könnt Ihr das nicht selbst erledigen?~
@10111 = ~Es klingt langweilig und ... ich habe keine Zeit dafür. Auf Wiedersehen.~
@10112 = ~Das ist es auch.~
@10113 = ~Ich muss auf die Verstärkung warten. Außerdem muss jemand hier bleiben.~
@10114 = ~Der schwierige Teil ist vielleicht, Nashkell zu erreichen, aber wenn Ihr den Weg kennt, wird es für Euch einfacher sein. Einfacher, als wenn ich selbst dorthin ginge.~
@10115 = ~Helft mir bei der Aufgabe, bitte. Ich brauche wirklich Eure Hilfe.~
@10116 = ~Sobald Ihr die Vorräte habt, kommt einfach hierher. Und ich werde darüber nachdenken, wie ich Euch belohnen kann, wenn die ganze Situation völlig unter Kontrolle ist.~
@10117 = ~Ihr seid zurück, wie ich sehe. Habt Ihr die Vorräte?~
@10118 = ~Ich habe die Vorräte hier.~
@10119 = ~Ich arbeite noch daran. Ich lasse es Euch wissen, sobald ich sie habe.~
@10120 = ~Prächtig! Gerade rechtzeitig! Schaut! Die Verstärkung ist da!~
@10121 = ~Manlytoe! Hier!~
@10122 = ~Es ist gut, Euch lebendig zu sehen, Stilind! Wo sind die anderen?~
@10123 = ~Sie sind ...~
@10124 = ~...~
@10125 = ~Es tut mir wirklich leid, Stilind. Wirklich. War Mandar bei ihnen? Ich weiß, dass Ihr zwei unzertrennlich wart.~
@10126 = ~Ja. Er ... er ist auch fort ...~
@10127 = ~Bei den Göttern, seine Familie wird am Boden zerstört sein.~
@10128 = ~Ich werde es ihnen sagen. Sobald ich zurück bin. Sobald unsere Mission vorbei ist.~
@10129 = ~Konzentrieren wir uns ... auf das, was ansteht. Bitte.~
@10130 = ~Natürlich. Wie ist die Lage?~
@10131 = ~Die Festung ist gesichert. Ich habe Hilfe von diesem tapferen Kämpfer hier bekommen.~
@10132 = ~Nun ... gern geschehen.~
@10133 = ~Ich tue es für eine Belohnung. Ich hoffe, das ist klar.~
@10134 = ~Ihr müsst recht stark sein. Gute Arbeit.~
@10135 = ~Verstehe. Das ist ... gut zu wissen.~
@10136 = ~Es muss schwierig gewesen sein, sich all diesen Kreaturen zu stellen.~
@10137 = ~Ja ... Für den Fall, dass es wieder schiefgeht, hat unser Freund hier die medizinischen Vorräte für uns geholt. Die aus Nashkell.~
@10138 = ~Gut. Aber hoffen wir, dass wir sie nicht brauchen.~
@10139 = ~Richtig.~
@10140 = ~Ihr und Eure Leute solltet Euch jetzt ausruhen und diese Hallen und Wände selbst überprüfen. Es könnte sich als nützlich erweisen. In der Zwischenzeit gibt es noch einen letzten Gefallen, um den ich unseren Helfer bitten muss. Sprecht mich an, wenn Ihr bereit seid.~
@10141 = ~Ihr habt uns sehr geholfen, mein Freund. Aber es gibt noch einen letzten Gefallen, um den ich Euch bitten muss.~
@10142 = ~Was ist es?~
@10143 = ~Tut mir leid, aber ich habe keine Zeit dafür. Ich sollte gehen.~
@10144 = ~Seht Ihr, als Ihr nach Nashkell aufgebrochen seid, habe ich herausgefunden, dass sich in dem Turm dort eine seltsame Kreatur befindet. Es gibt einen Riss in der Wand und ... dieser Turm scheint von einem bizarren Geist heimgesucht zu werden.~
@10145 = ~Ich bin mir nicht sicher, ob einer dieser Männer und Frauen Erfahrung im Kampf gegen Geister hat, daher hoffte ich, dass Ihr ihn vielleicht für uns erledigen könntet. Ich verspreche, dass dies der letzte Gefallen sein wird, um den ich Euch je bitten werde. Und wenn es vorbei ist, bekommt Ihr etwas von mir.~
@10146 = ~Ihr habt uns sehr geholfen, da wäre das nur fair.~
@10147 = ~Also ... ein Geist, sagt Ihr ...~
@10148 = ~Nein. Ich bin fertig damit, Euch zu helfen. Ich muss jetzt gehen. Auf Wiedersehen.~
@10149 = ~Ja. Helft uns, bitte. Ich verspreche, dass das, was ich für Euch habe, wirklich seinen Wert hat.~
@10150 = ~Hallo, Freund! Habt Ihr es geschafft, den Geist zu erledigen, von dem ich Euch erzählt habe?~
@10151 = ~Ja. Er wird Euch keinen Kummer mehr bereiten.~
@10152 = ~Nein, noch nicht. Auf Wiedersehen.~
@10153 = ~Bei den Göttern! Ihr seid wahrlich einer der mächtigsten Krieger, die ich je getroffen habe.~
@10154 = ~Diese Mission ist dank Euch kein Fehlschlag. Wir werden diesen Ort nutzen, um sicherzustellen, dass Reisen von Athkatla nach Nashkell von nun an sicherer sind.~
@10155 = ~Wie ich versprochen habe, habe ich etwas für Euch. Einen besonderen Umhang, der Euch schützen wird. Ich hoffe, er wird Euch gute Dienste leisten. Außerdem nehmt diese paar Münzen. Sechshundert Goldmünzen. Ich weiß, es ist nicht viel, aber ... mehr kann ich nicht bieten.~
@10156 = ~Danke für alles, was Ihr für uns getan habt. Seid versichert, dass Euer Name für uns alle hier zum Inbegriff eines furchtlosen Kriegers werden wird.~
@10157 = ~Ich freue mich immer, Euch zu sehen, mein Freund.~
@10158 = ~Ich sollte wohl später mein Schwert reinigen.~
@10159 = ~Bei den Göttern, ich hoffe wirklich, dass wir hier nicht sterben.~
@10160 = ~Ich mache noch ein paar Liegestütze vor dem Schlafengehen.~
@10161 = ~Der Weg hierher war gefährlich, aber ich glaube wirklich, dass wir hier gute Arbeit leisten können.~
@10162 = ~Innenbereich der Gnollfestung - Zweite Ebene~
@10163 = ~Gnollfestung - Unheimlicher Raum~
@10164 = ~Gnollfestung - Westlicher Lagerraum~
@10165 = ~Gnollfestung - Östlicher Lagerraum~
@10166 = ~Nun, der Ort ist nicht in Bestform, aber ich glaube, dass er sich mit einigen Ressourcen wieder herrichten lässt. Wände kann man ausbessern. Das wird etwas Gold erfordern, aber ... nichts davon ist unmöglich. Ich habe einige Waren hierher gebracht, falls wir Waffen oder Tränke brauchen.~
@10167 = ~Es ist gut, Euch wiederzusehen.~
@10168 = ~Wenn Ihr etwas braucht, kann ich Euch zeigen, was ich habe.~
@10169 = ~Zeigt mir Eure Waren.~
@10170 = ~Ich glaube, ich habe alles, was ich brauche. Auf Wiedersehen.~
@10171 = ~Lebt wohl.~
@10172 = ~Quartiermeister~
@10173 = ~Die Gnollfestung sichern~
@10174 = ~Die Gnollfestung sichern

Ich traf Hauptmann Stilind am Eingang der Gnollfestung. Er wollte Hilfe bei irgendeinem Unsinn und ich lehnte ab.~
@10175 = ~Die Gnollfestung sichern

Ich traf Hauptmann Stilind am Eingang der Gnollfestung. Er ist der letzte Rest einer Truppe, die von Athkatla ausgeschickt wurde, um die Gnollfestung zu sichern. Er bat mich um Hilfe beim Kampf gegen ihren Anführer, Häuptling Hvalanya, sowie gegen einen Schamanen einer rivalisierenden Gruppe. Außerdem muss ein Gnoll besiegt werden, der von einem der Türme aus Wache hält.~
@10176 = ~Die Gnollfestung sichern

Wir haben den Gnoll-Anführer Häuptling Hvalanya besiegt.~
@10177 = ~Die Gnollfestung sichern

Schamane Sirkhr, der Anführer der rivalisierenden Gnoll-Fraktion, wurde in einem alten Tempel unter der Festung besiegt.~
@10178 = ~Die Gnollfestung sichern

Der Wächter von den Türmen, Purkht, wurde getötet.~
@10179 = ~Die Gnollfestung sichern

Ich habe die drei Gnolle wie von Hauptmann Stilind gefordert besiegt. Ich sollte ihm am Eingang der Festung Bericht erstatten.~
@10180 = ~Die Gnollfestung sichern

Hauptmann Stilind ist zuversichtlich, dass die übrigen Gnolle sich zerstreuen werden, da ihre Anführer fort sind. Er hat mich gebeten, ihn tiefer in der Festung zu treffen.~
@10181 = ~Die Gnollfestung sichern

Stilind hat mich gebeten, medizinische Vorräte zu holen, während er auf Verstärkung aus Athkatla wartet. Ich sollte zum Tempel des Helm in Nashkell reisen und dem Priester sagen: "Die Hoffnung wandelt durch die Straßen Athkatlas".~
@10182 = ~Die Gnollfestung sichern

Ich sollte mit den medizinischen Vorräten von Nalin zu Hauptmann Stilind in die Gnollfestung zurückkehren.~
@10183 = ~Die Gnollfestung sichern

Mit seinen medizinischen Vorräten in der Hand und Verstärkung im Rücken hat Hauptmann Stilind nun die feste Kontrolle über die Gnollfestung. Er möchte später mit mir über eine weitere Aufgabe sprechen.~
@10184 = ~Die Gnollfestung sichern

Hauptmann Stilind hat mich gebeten, einen Geist zu untersuchen, der in einem Riss in der Wand auf der nächsten Ebene lauert.~
@10185 = ~Die Gnollfestung sichern

Der Geist, den Hauptmann Stilind erwähnte, ist besiegt. Ich sollte meinen Erfolg melden.~
@10186 = ~Die Gnollfestung sichern

Die Gnollfestung ist nun dank meiner Bemühungen eine Festung von Amn. Ich wurde von Hauptmann Stilind für meine Arbeit gut belohnt.~
@10187 = ~Hellebarde der Chimäre~
@10188 = ~Wie andere ihrer Art besteht diese Hellebarde aus einer beilartigen Axtklinge, die auf einem etwa zwei Meter langen Schaft sitzt. Entlang ihres Griffes verläuft eine Reihe von Runen, die es dem Träger ermöglichen, seinen Schlägen zusätzlichen Schaden durch Elektrizität, Kälte oder Feuer nach Wahl zu verleihen. Gelegentlich entlädt sie bei einem einzigen Schlag einen Stoß aller drei Elemente.

EIGENSCHAFTEN:

Kampffähigkeiten:
   1% Chance pro Treffer, dass das Ziel zusätzlich je 3 Punkte Kälte-, Elektrizitäts- und Feuerschaden erleidet

ETW0: +1
Schaden: 1W10+1
Schadensart: Stich
Speziell: +1 Kälte-, Elektrizitäts- oder Feuerschaden (nach Wahl des Trägers)
Gewicht: 14
Initiativefaktor: 8
Fertigkeit: Hellebarde
Typ: 2-händig
Benötigt: Stärke 13
Kann nicht verwendet werden von:
 Druide
 Kleriker
 Magier
 Dieb~
@10189 = ~Elektrizität~
@10190 = ~Kälte~
@10191 = ~Feuer~
@10192 = ~Die Spannungen mit Baldurs Tor wachsen, und diese Festung kontrolliert einen guten Abschnitt der Küste. Wir wollten nach getaner Arbeit hier zu den Minen von Nashkell weiterziehen. Aber wir wurden bemerkt.~
@10193 = ~Es mag ein gewaltiger Gegner sein, und Ihr seid der Aufgabe im Moment vielleicht nicht gewachsen. Wir können einige einfache Schutzsiegel errichten, um den Geist festzuhalten, bis Ihr bereit seid.~
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////                                                  \\\\\
///// Peaceful Kaishas resolution                      \\\\\
/////                                                  \\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\

@21604 = ~Warum müssen wir kämpfen? Kann Euch nicht mit all diesem Wissen gehen lassen. Wir hätten friedlich existieren können, aber nun habt Ihr gekämpft und werdet es niemals akzeptieren. Andere werden kommen und töten oder erobern. Abenteurer wie Ihr kommen doch immer, oder? Nein, ich muss kämpfen und Ihr müsst sterben! Es gibt vielleicht noch Hoffnung, wenn Selaad zurückkehrt, aber Ihr könnt nicht mehr helfen.~
@21605 = ~Kaishas, wir haben nur gekämpft, weil wir dazu gezwungen wurden. Es war nicht unsere Tuen, sondern Eures und es gibt keinen Grund, warum das fortgesetzt werden muss.~
@21606 = ~Wir wurden dazu gezwungen zu kämpfen, Kaishas, und wir haben gut gekämpft - glaubt Ihr wirklich, dass Ihr uns aufhalten könnt, indem Ihr dieses Schiff entert?~
@21607 = ~Euer Dorf und die Tunnel darunter sind nun angefüllt mit den Kadavern der Eurigen. Falls Ihr wirklich kämpfen wollt, dann sei dem so, aber Ihr macht einen Fehler.~
@21608 = ~Sterbt, - wenn Ihr ein Monster seid, sollte ich Euch als solches behandeln.~
@21609 = ~Welch Großzügigkeit, aber falls Ihr geht, werdet Ihr ohnehin ausrotten. Andere werden kommen, andere Narren nur um das "Böse" zu bekämpfen, das wir sind. Nein, wir müssen nun hier alleine zurückbleiben und selbiges müsst Ihr. Sterbt und schlaft und Ihr werdet die Einsamkeit nicht kennen. Falls Selaad zurückkehrt, werden wir es vielleicht wieder versuchen. Bis dahin bleiben wir.~
@21610 = ~Kaishas, es gibt keinen Grund hierfür. Ich will es nicht tun, aber wir werden Euch töten, wenn wir müssen. Glaubt Ihr wirklich Ihr könnt uns aufhalten, obwohl Karoug und Daese es nicht konnten?~
@21611 = ~Ich... fürchte, dass wir es nicht können. Aber wir sollten es versuchen. Uns bleibt keine Wahl.~
@21612 = ~Kaishas, das ist Wahnsinn. Ihr werdet in den Tod gehen und ich will Euch nicht einmal töten!~
@21613 = ~Vielleicht nicht. Aber Ihr seid verwundet und müde und die Meute ist dicht hinter Euch. Selbst Abenteurer können nur so lange kämpfen. Ungeachtet dessen, es muss so sein. Es tut mir wahrlich leid.~
@21614 = ~Ich habe nur ungern mit Kaishas gekämpft. Sie schien zu denken, dass es keinen anderen Weg geben würde. Sie hat erwähnt, dass es eine zweite Chance geben könnte, falls Selaad eines Tages zurückkehrt. Er ist der vermisste Häuptling, wenn ich mich richtig erinnere.~
@21615 = ~Vielleicht sind wir Monster. Aber wir tun, was wir müssen, um zu überleben.~
@21616 = ~Ihr erinnert mich nur daran, dass dies sein muss. Zu viel ist zwischen uns geschehen. Ich weiß nicht, ob wir Euch aufhalten können oder nicht, aber die Antwort wird schnell bekannt sein.~
@21617 = ~Welche Wahl gibt es? Falls die Wahrheit bekannt ist, wird Verderben über uns kommen!~
@21618 = ~Dann sei es so.~
@21619 = ~Ihr könnt uns vertrauen. Wir werden niemand von Eurem Volk erzählen - es wird sein, als wären wir nie an diesen Ort gekommen.~
@21620 = ~Sterbt gut... es tut mir wahrlich leid, dass es auf diese Weise enden muss.~
@21621 = ~Wie gerne würde ich Euch glauben! Aber versteht genau, die Zukunft meines Volkes steht hier auf dem Spiel. Ich kann kein Risiko eingehen.~
@21622 = ~Wir haben unser Leben jeden Tag, seit dem wir hier angespült worden sind, für Euer verdammtes Volk riskiert! Was müssen wir noch tuen, um Euch zu überzeugen? Wieviele Babies müssen wir noch vor den Wolfweren retten? ~
@21623 = ~Wir haben unser Leben jeden Tag, seit dem wir hier angespült worden sind, für Euer verdammtes Volk riskiert! Was müssen wir noch tuen, um Euch zu überzeugen?~
@21624 = ~Ihr könnt nichts tun. Es tut mir wahrlich Leid.~
@21625 = ~Ihr... könnt nichts tun. Maralee wird für Eure Tat für immer dankbar sein.... genauso wie ich. Aber obwohl es tapfer war, habt Ihr es getan ohne unsere wahre Natur zu erkennen.~
@21626 = ~Und nun erkenne ich sie. Macht Euch bereit, Kaishas - dies endet nun.~
@21627 = ~Langsam wird es lächerlich. Eure Undankbarkeit macht mich krank - ich hatte gehofft, dass ich Euch nicht als Monster sehen muss, aber es sieht aus, als wäre ich da falsch gelegen.~
@21628 = ~Kaishas, haltet Ihr mich für einen Narren? Ich wusste, dass Ihr Werewölfe seit, selbst bevor ich mit Karoug gesprochen hatte... offen gesagt war ich fünf Minuten nachdem ich Euer Dorf betreten hatte Euch gegenüber misstrauisch! Falls Ihr versucht uns zu töten, dann fahrt damit fort, aber um Aos Willen, zollt uns etwas Anerkennung für unsere Intelligenz!~
@21629 = ~Ich zolle Euch große Anerkennung, sowohl für Intelligenz als auch für Tapferkeit. Dennoch ist dies alles die Pflicht einer Anfühererin. Ich kann es nicht riskieren, dass Ihr lügt.~
@21630 = ~Kaishas, bitte, wartet! <CHARNAME> lügt nicht! <PRO_HESHE> und ich haben eine Verbindung gefunden... lange nachdem <PRO_HESHE> die Wahrheit über uns erkannt haben muss! Verschont <PRO_HIMHER> - <PRO_HESHE> mag unsere wahre Natur kennen, aber <PRO_HESHE> wird das Geheimnis für sich behalten.~
@21631 = ~Ich...~
@21632 = ~Kaishas, mein Peladan ist wegen diesen Außenstehenden immer noch am Leben. Soll ich ihn aufwachsen lassen, in dem Wissen, dass wir Peladans Retter abgeschlachtet haben? Dass wir in Wahrheit genauso wie in unserer äußeren Form Monster sind?~
@21633 = ~Ich... ich war ein Narr. Vergebt mir, <CHARNAME>, dass ich uns an der Rand der Verwandtschaft mit wilden Tieren gebracht habe. Aber wir sind besser als Karoug... danke, dass Ihr das gewusst habt, selbst als ich es vergessen hatte.~
@21634 = ~Geht, in Frieden. Ich weiß nicht, was sich ereignen wird, wenn Ihr meinen Ehemann gegenübertretet. Ich fürchte sehr um ihn, aber hat sein Schicksal selbst in der Hand. Falls er das Geschenk nicht bereitwillig zurücknimmt... dann müsst Ihr tun, was Ihr tun müsst.~
@21635 = ~Eines Tages, hoffe ich, wird Peladan ein Geschwisterchen haben. <PRO_HISHER> Name wird "<CHARNAME>" sein.~
@21636 = ~Wir werden uns nie wieder treffen, <CHARNAME>. Das... bekümmert mich. Erinnert Euch an mich, selbst wenn Ihr alles andere über unser Volk vergesst.~
@21637 = ~Ich habe es geschafft Kaishas Gan davon zu überzeugen, uns in Frieden gehen zu lassen... mit ein bisschen Hilfe von Delainy. Ein reizendes Mädchen, aber manche Dinge sollen nicht sein, nehme ich an.~
@21638 = ~Ich habe es geschafft Kaishas Gan davon zu überzeugen, uns in Frieden gehen zu lassen... mit ein bisschen Hilfe von Durlyle. Es gab etwas besonderes zwischen uns... aber manche Dinge sollen nicht sein, nehme ich an.~
@21639 = ~Das tut es in der Tat. Wahrlich, es tut mir leid.~
@21640 = ~Ihr beschämt mich, Außenstehender. Groß ist unsere Schuld Euch gegenüber. Dennoch ist dies alles die Pflicht einer Anfühererin. Ich kann es nicht riskieren, dass Ihr lügt.~
@21641 = ~Ihr seid zurückgekehrt! Und Ihr seid im Rudel... ich rieche es an Euch. Aber wo ist Kaishas? Wo ist mein Gefährte?~
@21642 = ~Warum habt Ihr uns geschickt? Was sollte auf dieser Insel passieren?~
@21643 = ~Sie ist auf der Insel zurückgeblieben. Euer Gefährtin hätte uns beinahe getötet, als wir den Fluch ablehnten, den sie auf uns gelegt hat... aber zuletzt ist sie weise geworden. Erlöst uns von dem "Geschenk" und kehrt zurück zu ihr, "Mendas". Es gibt hier nichts für Euch.~
@21644 = ~Das Logbuch war nichts! Balduran war nichts! Er hatte das Geschenk abgelehnt, dass die Großväter ihm angeboten haben. Ihr solltet nur Kaishas die Seekarten geben und Karoug töten, damit er ihr nicht folgen kann. Kaishas hätte das Rudel hierher gebracht, wo ich alles vorbereitet habe. Erbärmlich! Ihr konntet solch einfache Aufgaben nicht erfüllen? Stattdessen lasst Ihr meine Familie im Stich und stehlt das Boot um Euer grausames Leben zu retten?~
@21645 = ~Nun ist es Zeit, dieses Wortgeplänkel zu beenden, Mendas. Es ist Zeit, dass Ihr für Eure Lügen und Eure Bosheit zahlt. Bereitet Euch vor zu sterben.~
@21646 = ~Dies endet hier. Erlöst uns von dem "Geschenk" und kehrt zu Eurem Gefährten zurück, Mendas. Es gibt hier nichts für Euch.~
@21647 = ~Hunde! Ihr seid es nicht wert, durch meine Hand zu sterben, aber sterben sollt Ihr! Zu mir, Baresh! Eine blutige Abrechnung steht bevor!~
@21648 = ~Das Rätsel dieser Insel ist klar geworden. Mendas/Selaad hat uns unter dem falschen Vorwand, wir sollen Beweise in dem, was für Baldurans Schiffswrack gehalten wird, aufspüren, auf die Insel geschickt. Es war in der Tat das Schiff des Abenteurers, obgleich sein persönliches Schicksal immernoch ein Geheimnis bleibt. Baldurans Mannschaft wurde irgendwann während dieser schicksalhaften Reise mit Lycanthrophie infiziert. Das Schiff wurde auf Grund gesetzt und abgewrackt, wodurch die zwei Stämme der Lycanthropen, Werwölfe und Wolfwere, zurückblieben und gegeneinander um das Überleben kämpfen mussten. Die besser organisierten Werwölfen haben ein Dorf gebaut, in dessen Nähe wir kürzlich auf unsere eigenen schicksalhaften Reise Schiffbruch erlitten. Die chaotischen Wolfwere bezogen Ihr Quartier in den Ruinen von Baldurans Schiff und beide Rudel überlebten seitdem in einer unruhigen Koexstistenz. Mendas/Selaad ist letztlich das Risiko eingegangen zum Festland zu segeln. Irgendwie hat er es geschafft und sich eine plausible Geschichte ausgedacht, da er entdeckt hatte, dass jemand schließlich die Insel gefunden hatte. Zunächst hat er uns die Seekarten stehlen und später zu der Insel reisen lassen, um sie in die Hände seiner Werwolf-Gefährtin zu übergeben. Sie hat uns die Wolfwere töten lassen und dann unsere Gruppe mit Lycanthrophie angesteckt, in der Absicht, dass wir uns dem Rudel anschließen oder im Kampf sterben. Aber wir konnten sie davon überzeugen, uns in Frieden gehen zu lassen. Wir sind schlussendlich nach Hause gesegelt, um die Wahrheit über Mendas Doppelzüngigkeit herauszufinden. Das Schicksal scheint es zu genießen, mit mir zu spielen.~
@21649 = ~Ich bin verwundert, Mendas, oder sollte ich sagen Selaad. Da Ihr der Anführer der Werwölfe seid, warum segelt Ihr nicht selbst zur Insel zurück?~
@21650 = ~Ich bin kein Seefahrer. Ich bleibe, um diesen Ort für mein Volk vorzubereiten. Für Generationen waren wir auf der Insel gefangen. Es ist Zeit, dass wir in das Land unserer Großväter heimkehren. Sie haben Karten gebraucht und ich Abenteurer, die nicht viele Fragen stellen. Dennoch seid Ihr gescheitert. Ich frage nochmal - wo ist Kaishas?~
@21651 = ~"Erlösen"? Meine närrische Gefährtin, was habt Ihr ihnen erzählt? Das ist kein Fluch, den man aufheben muss - es ist ein Geschenk, das man auskosten muss! Er kann nur "geheilt" werden, indem man den Häuptling der Werwölfe tötet. Ich bin der Häuptling und ich befinde Euch für unwürdig, mit meine Rudel umherzuziehen. Ihr werdet heute hier sterben. Zu mir Baresh! Eine blutige Abrechnung steht bevor!~
@21652 = ~Selaad Gan ist der Anführer des wahren Volkes. Er erwartet die Rückkehr seiner Gefährtin Kaishas. Warum seid Ihr nicht mit Ihr zurückgekehrt?~
@21653 = ~Es ist nicht an Euch, mit Fragen zu stellen. Welche Rolle habt Ihr hierbei gespielt?~
@21654 = ~Es scheint, dass Ihr in die Irre geführt wurdet. Kaishas ist tot und ihre mörderische Art ist mit ihr gestorben.~
@21655 = ~Wir wurden angeheuert, um Baldurans Logbuch wieder zu finden. Wir haben es hierher gebracht und nun erwarten wir Bezahlung.~
@21656 = ~Es scheint, dass Ihr in die Irre geführt wurdet. Kaishas bleibt auf der Insel. Wir müssen Selaad gegenübertreten und ihn den Fluch aufheben lassen, den uns seine Gefährtin närrischer Weiser beschert hat.~
@21657 = ~Der Meister wünscht seine Frau, Kaishas Gan, zu sehen. Ist sie immer noch auf dem Schiff?~
@21658 = ~Das geht Euch nichts an. Tretet beiseite.~
@21659 = ~Wer ist Euer Meister? Wir arbeiten für Mendas von Tiefwasser.~
@21660 = ~Ich bin Baresh. Ich bin von der wahren Rasse, nicht so wie Ihr. Der Meister wünscht seine Frau, Kaishas Gan, zu sehen. Ist sie immer noch auf dem Schiff?~
@21661 = ~Das Buch ist nicht! Eure Aufgabe war es, die Sippe des Meisters zu retten. Wo ist die Gefährtin des Meisters, Kaishas?~
@21662 = ~Eure Aufgabe war klar. Reist zu der Inselheimat und rettet die Sippe des Meisters. Da Ihr dabei gescheitert seid, sollte Kaishas die Seekarten von Euch nehmen. Unnütze Menschlinge! Selaad duldet Versagen nicht wirklich gut.~
@21663 = ~Idiot! Wir wurden unter falschem Vorwand ausgeschickt und irgendwie ist es unsere Schuld? Kaishas hat uns angegriffen und wir waren gezwungen, uns selbst zu verteidigen. Mendas wurde von seiner eigenen Gerissenheit betrogen.~
@21664 = ~Mendas hat uns getäuscht. Er ist der, dem wir gegenübertreten müssen. Ihr seid kaum ein Lakai.~
@21665 = ~Idioten! Wir wurden unter falschem Vorwand ausgeschickt und irgendwie ist es unsere Schuld? Bringt uns nun zu Selaad!~
@21666 = ~Nutzloser Schuft! Dafür wird der Meister Euch das Mark aus den Knochen saugen!~

