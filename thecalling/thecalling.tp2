BEGIN @40023 DESIGNATED 40
SUBCOMPONENT @40000 
GROUP @9
REQUIRE_PREDICATE GAME_IS ~bgee tutu tutu_totsc bgt eet~ @0
REQUIRE_PREDICATE NOT MOD_IS_INSTALLED ~CDTWEAKS/SETUP-CDTWEAKS.TP2~ ~1090~ @1 // skip if already installed by tweaks anthology
LABEL ~cd_the_calling_exotic_items~

OUTER_SET remove_bgee_exotics = 0
INCLUDE ~thecalling/lib/exotic.tpa~

/////                                                  \\\\\
///// Exotic Items Pack - just add items               \\\\\
/////                                                  \\\\\

BEGIN @40024 DESIGNATED 41
SUBCOMPONENT @40000 
GROUP @9
REQUIRE_PREDICATE GAME_IS ~bgee eet~ @0
REQUIRE_PREDICATE NOT MOD_IS_INSTALLED ~CDTWEAKS/SETUP-CDTWEAKS.TP2~ ~1090~ @1 // skip if already installed by tweaks anthology
LABEL ~cd_the_calling_exotic_items_remove_bgee~

OUTER_SET remove_bgee_exotics = 1
INCLUDE ~thecalling/lib/exotic.tpa~

