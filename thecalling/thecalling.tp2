COPY //~thecalling/tilesets/BG5100sr.bmp~  ~override/%GnollStronghold%sr.bmp~ // stronghold searchmap; give new entrances a little more walking room
     ~thecalling/tilesets/BG5100LN.bmp~  ~override/%GnollStronghold%LN.bmp~

INCLUDE ~%MOD_FOLDER%/lib/alter_searchmap.tpa~
LAF ALTER_SEARCHMAP
	STR_VAR
	path_to_2da_file = ~thecalling/tilesets/BG5100SR_changes.2da~ // full path to the *changes.2da file containing your icons, e.g. ~mymod/bam/AR3700SR_changes_ee.2da~
	areaname = EVAL ~%GnollStronghold%~ // area name, e.g. ~AR3700~
	output_path	= EVAL ~override~ // output directory
END

COPY ~%MOD_FOLDER%/tilesets/ysriv~ ~override~ // overlay night animation

COPY ~thecalling/are/old/BG5100N.wed~ ~override/%GnollStronghold%N.wed~ // wed
  WRITE_ASCIIE 0x24 ~%GnollStronghold_BCS%N~ #8
//ACTION_IF tutu_gen BEGIN
//  COPY_EXISTING ~%GnollStronghold%.wed~ ~override~
//    WRITE_ASCIIE 0x24 ~%GnollStronghold%~ #8
//END

ACTION_IF enhanced_edition BEGIN

  // add new areas to the console menu listing
  COPY_EXISTING ~bgee.lua~ ~override~
    SPRINT cd5104_descript @10023 // do it this way so that the entries can also be translated
    SPRINT cd5105_descript @10026
    SPRINT cd5106_descript @10162
    SPRINT cd5107_descript @10163
    SPRINT cd5108_descript @10164 
    SPRINT cd5109_descript @10165 
    REPLACE_TEXTUALLY ~\({"%GnollStronghold_CrawlerCave%",.+},\)~ ~\1
	{"cd5104", "%cd5104_descript%"},
	{"cd5105", "%cd5105_descript%"},
	{"cd5106", "%cd5106_descript%"},
	{"cd5107", "%cd5107_descript%"},
	{"cd5108", "%cd5108_descript%"},
	{"cd5109", "%cd5109_descript%"},~
  
  COPY ~thecalling/tilesets/10~            ~override~                       // new area tilesets/pvrz
       ~thecalling/tilesets/old/BG5100.tis~ ~override/%GnollStronghold%.tis~ // updated gnoll stronghold
       ~thecalling/tilesets/old/BG5100N.tis~ ~override/%GnollStronghold%N.tis~
  
  ACTION_IF GAME_IS ~bgee~ BEGIN
    ACTION_BASH_FOR ~%MOD_FOLDER%/tilesets/old~ ~.*\.pvrz$~ BEGIN
      OUTER_PATCH_SAVE newname ~%BASH_FOR_RES%~ BEGIN
        REPLACE_TEXTUALLY CASE_INSENSITIVE EXACT_MATCH ~B~ ~A~
      END
      COPY ~%BASH_FOR_FILESPEC%~ ~override/%newname%.pvrz~
    END
  END ELSE BEGIN
    ACTION_BASH_FOR ~%MOD_FOLDER%/tilesets/old~ ~.*\.pvrz$~ BEGIN
      COPY ~%BASH_FOR_FILESPEC%~ ~override~
	END
  END
  /*
  ACTION_IF game_is_bgee BEGIN OUTER_SPRINT prefix ~a~ END ELSE BEGIN OUTER_SPRINT prefix ~b~ END
  OUTER_FOR (index = 510000; index < 510022 ; ++index) BEGIN
    COPY ~thecalling/tilesets/old/a%index%.pvrz~ ~override/%prefix%%index%.pvrz~
  END
  */
  
END ELSE BEGIN

  INCLUDE ~thecalling/lib/a7_tools.tpa~ // tile2ee
  LAF HANDLE_TILE2EE INT_VAR quality_v1 = 9 STR_VAR input_path = ~thecalling/tilesets/10~ END // new area tilesets/pvrz
  
  COPY ~thecalling/tilesets/bg5100.mos~  ~override/%GnollStronghold%.mos~  // minimap 
       ~thecalling/tilesets/bg5100N.mos~ ~override/%GnollStronghold%N.mos~ // minimap 
       ~thecalling/tbc/bg5100.tbc~       ~weidu_external/thecalling/tbc/%GnollStronghold%.tbc~  // tileset 
       ~thecalling/tbc/bg5100N.tbc~      ~weidu_external/thecalling/tbc/%GnollStronghold%N.tbc~ // tileset 
  
//  LAF HANDLE_TILESETS STR_VAR input_path = EVAL ~thecalling/tiz/%tutorbgt%~ END
    LAF HANDLE_TILECONV
	  STR_VAR
	    input_path    = ~weidu_external/thecalling/tbc~
	    output_path	  = EVAL ~override~
    END
END

COPY_EXISTING ~%GnollStronghold%.are~ ~override~ // adding entrances to main gnoll stronghold map
  // turn the area in an extended nightmap
  PATCH_IF SOURCE_SIZE > 0x11b BEGIN // Valid size check
    PATCH_IF (((BYTE_AT 0x48) << 7) & BIT7) BEGIN // Toggle only outdoor areas
      WRITE_BYTE 0x48 (THIS | BIT6 | BIT1 | BIT2) // Toggle extended night flag (BIT6) and day/night flag (BIT1) and weather flag (BIT2)
	  GET_OFFSET_ARRAY actors 0x54 4 0x58 2 0 0 0x110		// turn off creatures at night time
      PHP_EACH actors AS i => off BEGIN
	    READ_ASCII off + 0x80 cre_resref
	    TO_LOWER cre_resref
	    PATCH_IF VARIABLE_IS_SET $turn_off_at_night("%cre_resref%") BEGIN
	      WRITE_LONG off + 0x40 0x1ffe0 // 05:30 to 17:29
	    END
	  END
	END
  END
  //DUNGEON	
  LPF fj_are_structure INT_VAR
    fj_type = 2 // travel
    fj_box_left = 2977
    fj_box_top = 2261
    fj_box_right = 3059
    fj_box_bottom = 2378
    fj_cursor_idx = 42
    fj_flags = 516 // no_NPCs = 512, party_required = save = 4
    fj_alt_x = 3053
    fj_alt_y = 2390
    fj_loc_x = 3053
    fj_loc_y = 2390
    fj_vertex_0 = 2977 + (2378 << 16)
    fj_vertex_1 = 2977 + (2321 << 16)
    fj_vertex_2 = 2997 + (2301 << 16)
    fj_vertex_3 = 3006 + (2291 << 16)
    fj_vertex_4 = 3010 + (2266 << 16)
    fj_vertex_5 = 3015 + (2261 << 16)
    fj_vertex_6 = 3037 + (2313 << 16)
    fj_vertex_7 = 3052 + (2333 << 16)
    fj_vertex_8 = 3059 + (2342 << 16)
  STR_VAR
    fj_structure_type = region
    fj_name = CD_GnollUnd
    fj_destination_area = CD5104
    fj_destination_name = En
  END
  LPF fj_are_structure INT_VAR
    fj_loc_x = 3053
    fj_loc_y = 2390
    fj_orientation = 14 // facing direction (0-15 where 0=south, 4=west, 8=north, 12=east)*;
  STR_VAR
    fj_structure_type = entrance
    fj_name = CD5104E
  END
  //MAIN - archway entrance
  LPF fj_are_structure INT_VAR
    fj_type = 2 // travel
    fj_box_left = 2211
    fj_box_top = 1652
    fj_box_right = 2315
    fj_box_bottom = 1794
    fj_cursor_idx = 42
    fj_flags = 516 // no_NPCs = 512, party_required = save = 4
    fj_alt_x = 2235
    fj_alt_y = 1799
    fj_loc_x = 2235
    fj_loc_y = 1799
    fj_vertex_0 = 2211 + (1745 << 16)
    fj_vertex_1 = 2211 + (1669 << 16)
    fj_vertex_2 = 2230 + (1652 << 16)
    fj_vertex_3 = 2250 + (1652 << 16)
    fj_vertex_4 = 2281 + (1667 << 16)
    fj_vertex_5 = 2301 + (1688 << 16)
    fj_vertex_6 = 2315 + (1716 << 16)
    fj_vertex_7 = 2314 + (1776 << 16)
    fj_vertex_8 = 2309 + (1794 << 16)
  STR_VAR
    fj_structure_type = region
    fj_name = CD_GnollMain
    fj_destination_area = CD5105
    fj_destination_name = en_arch
  END
  LPF fj_are_structure INT_VAR
    fj_loc_x = 2235
    fj_loc_y = 1799
    fj_orientation = 2 // facing direction (0-15 where 0=south, 4=west, 8=north, 12=east)*;
  STR_VAR
    fj_structure_type = entrance
    fj_name = CD5105E_arch
  END
  //MAIN - back entrance
  LPF fj_are_structure INT_VAR
    fj_type = 2 // travel
    fj_box_left = 2103
    fj_box_top = 1352
    fj_box_right = 2253
    fj_box_bottom = 1459
