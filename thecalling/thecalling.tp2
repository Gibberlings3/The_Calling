BEGIN @100 DESIGNATED 0
GROUP @8
REQUIRE_PREDICATE GAME_IS ~bgee tutu tutu_totsc bgt eet~ @0
REQUIRE_PREDICATE (("%LANGUAGE%" STRING_COMPARE_CASE "english" = 0) OR 
                   ("%LANGUAGE%" STRING_COMPARE_CASE "french" = 0) OR 
                   ("%LANGUAGE%" STRING_COMPARE_CASE "german" = 0) OR 
                   ("%LANGUAGE%" STRING_COMPARE_CASE "polish" = 0) OR 
                   ("%LANGUAGE%" STRING_COMPARE_CASE "russian" = 0) OR 
                   ("%LANGUAGE%" STRING_COMPARE_CASE "schinese" = 0) OR 
                   ("%LANGUAGE%" STRING_COMPARE_CASE "spanish" = 0)) @5 // skip if translation doesn't exist
LABEL ~cd_the_calling_mage~

/////                                                  \\\\\
///// the mage calling                                 \\\\\
/////                                                  \\\\\

/*

*CDBracerQuest

*1 quest accepted, promps meli cutscene
*2 after cutscene
*3 in thalantyr's post-cutscene dlg
*4 one gem returned
*5 two gems in
*6 all three gems, go see taerom
7 taerom met, go see grace at mines
8 grace spoken with
9 meli spawned in nashkel
10 miners fixed, meli returning, go speak to taerom again
11 device in progress
*12 device ready
13 melicamp-nashkel stuff skipped
14 melicamp returns device
15 thalantyr does divination
*16 divination cutscene done
17 go get bracers from halflings
18 halfling cutscene, dialogue; goes to 19 or 80
*19 halflings sent to high hedge
20 incantation complete, go to cutscene
*21 cutscene complete
22 bracers removed badly, quest over
23 bracers removed, take 'em to taerom
24 spoken to taerom, start cutscene
25 cutscene end, last taerom dialogue
26 quest over, completed successfully

98 refused quest
99 melicamp gone on quest instead
*/

ADD_JOURNAL TITLE (@1335) @1336 @1337 @1338 @1339 @1340 @1341 @1342 @1343 @1344 @1345
                          @1346 @1347 @1348 @1349 @1350 @1351 @1352 @1353 @1354 @1355
                          @1356 @1357 @1358 @1359 @1360 @1361 @1362 @1363

// extend scripts for areas
EXTEND_BOTTOM ~%HighHedge_ThalanthyrsAbode_BCS%.bcs~   ~thecalling/baf/_ar3202.baf~ EVALUATE_BUFFER // thalantyr does stuff
EXTEND_BOTTOM ~%Beregost_ThunderhammerSmithy_BCS%.bcs~ ~thecalling/baf/_ar3301.baf~ // taerom cutscene
EXTEND_BOTTOM ~%UlcasterRuins_BCS%.bcs~                ~thecalling/baf/_ar3901.baf~ // add note
EXTEND_BOTTOM ~%Gullykin_House1_L1_BCS%.bcs~           ~thecalling/baf/_ar4005.baf~ // spawn iris & largo
EXTEND_BOTTOM ~%NashkelMines_BCS%.bcs~                 ~thecalling/baf/_ar5400.baf~ // spawn grace
EXTEND_BOTTOM ~%NashkelMines_L1_BCS%.bcs~              ~thecalling/baf/_ar5401.baf~ // spawn melicamp, miners

STRING_SET  7133 @126 // pearl > white pearl
STRING_SET 16380 @111 // add scrying stuff to descript of zircon

// start with dupe dialogues for the halfling couple
COPY_EXISTING ~%tutu_var%halffg.dlg~ ~override/cdiris.dlg~
              ~%tutu_var%halfgu.dlg~ ~override/cdlargo.dlg~

/* 
alright, so some BS follows. The original quest rewards the PC in melica 25 (BGT/Tutu)
or thalan 32 (BGEE), which both fall after we fork melica 24 for the quest initiation. So 
we copy transitions from those rewards state and then use alter_trans to fork the newly copied
transitions to have the proper triggers and GOTO target. We have additional checks to see if
we're copying multiple transitions from the reward state, and then have to also account for 
other mods adding transitions to melica 24 so that alter_trans hits the right state. Any 
extra transitions from the rewards state get False()d in the OUTER_FOR loop below. 
*/
OUTER_SPRINT rewards_dlg "%tutu_var%melica" 
OUTER_SET rewards_state = 25
ACTION_IF game_is_bgt BEGIN 
  OUTER_SPRINT thalan_states "1 35" 
END ELSE BEGIN 
  OUTER_SPRINT thalan_states "1" 
  ACTION_IF game_is_bgee BEGIN 
    OUTER_SPRINT rewards_dlg "thalan"  
    OUTER_SET rewards_state = 32
  END   
END

OUTER_SET meli24_trans = 1 // failsafe value
COPY_EXISTING ~%tutu_var%melica.dlg~ ~override~
  READ_LONG 0x08 state_num
  READ_LONG 0x0c state_off
  PATCH_IF state_num >= 23 BEGIN 
    READ_LONG (state_off + 0x08 + (0x10 * 23)) meli24_trans
  END
  BUT_ONLY

OUTER_SET rewardsdlg_trans = 1 // failsafe value
COPY_EXISTING ~%rewards_dlg%.dlg~ ~override~
  READ_LONG 0x08 state_num
  READ_LONG 0x0c state_off
  PATCH_IF state_num >= rewards_state BEGIN 
    READ_LONG (state_off + 0x08 + (0x10 * rewards_state)) rewardsdlg_trans
  END
  BUT_ONLY
              
ACTION_IF enhanced_edition BEGIN // on EEs, have Thalantyr identify the Black Pearl before giving it to player in case Anthology's 'gems require ID is installed'

  OUTER_SPRINT give_pearl ~CreateItem("cdbpearl",1,0,0) SetItemFlags("cdbpearl",IDENTIFIED,TRUE) GiveItem("cdbpearl",LastTalkedToBy(Myself))~

END ELSE BEGIN

  OUTER_SPRINT give_pearl ~GiveItemCreate("cdbpearl",LastTalkedToBy(Myself),1,0,0)~

END

// add mih gems
OUTER_SPRINT mih_ruby ~~
OUTER_SPRINT mih_sapphire ~~
ACTION_IF FILE_EXISTS_IN_GAME ~mh#gem01.itm~ BEGIN // ruby

  COPY_EXISTING ~mh#gem01.itm~ ~override~
    READ_LONG 0x0c name
    BUT_ONLY
    
  OUTER_SPRINT mih_ruby ~~~~~
IF ~Global("cd_mh#gem01","LOCALS",0) PartyHasItem("mh#gem01")~ THEN REPLY #%name% 
  DO ~SetGlobal("cd_mh#gem01","LOCALS",1) TakePartyItem("mh#gem01") DestroyItem("mh#gem01") IncrementGlobal("CDGemQuality","GLOBAL",3)~ GOTO GemQ3
~~~~~                                                      
END 
ACTION_IF FILE_EXISTS_IN_GAME ~mh#gem02.itm~ BEGIN // ruby

  COPY_EXISTING ~mh#gem02.itm~ ~override~
    READ_LONG 0x0c name
    BUT_ONLY
    
  OUTER_SPRINT mih_sapphire ~~~~~
IF ~Global("cd_mh#gem02","LOCALS",0) PartyHasItem("mh#gem02")~ THEN REPLY #%name% 
  DO ~SetGlobal("cd_mh#gem02","LOCALS",1) TakePartyItem("mh#gem02") DestroyItem("mh#gem02") IncrementGlobal("CDGemQuality","GLOBAL",3)~ GOTO GemQ3
~~~~~                                                      
END 

COMPILE EVALUATE_BUFFER ~thecalling/dlg/mage.d~
                        ~thecalling/baf/cdiris.baf~
                        ~thecalling/baf/cdlargo.baf~
                        ~thecalling/baf/cdminer1.baf~

// false extra transitions that get added to meli 24 via COPY_TRANS
OUTER_FOR (index = 1 ; index < rewardsdlg_trans ; ++index) BEGIN
  OUTER_SET targeted_trans = index + meli24_trans
  COMPILE EVALUATE_BUFFER ~thecalling/dlg/meli24.d~
END

// melicamp needed for quests, so make sure he always survives anti-chickenator
ACTION_IF enhanced_edition BEGIN // ees move the cutscene to the dialogue, so

  OUTER_SET cd_journal1 = 27256
  ACTION_IF game_is_eet BEGIN OUTER_SET cd_journal1 += 200000 END // bg strings in eet are +200000
  OUTER_SET cd_journal2 = cd_journal1 + 1
  OUTER_SET cd_journal3 = cd_journal1 + 2
  
  COMPILE ~thecalling/dlg/melicamp_lives.d~ EVALUATE_BUFFER

END ELSE BEGIN

  COPY_EXISTING ~%tutu_scriptt%halantr.bcs~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      REPLACE_TEXTUALLY ~Kill("melicamp")~ ~~
    END
    BUT_ONLY

END

// add some black pearls to the game
COPY_EXISTING_REGEXP GLOB ~^.+\.cre$~ ~override~
  SET pearl = 0
  READ_LONG 0x2bc itm_off
  READ_LONG 0x2c0 itm_num
  FOR (index = 0 ; index < itm_num ; ++index) BEGIN 
    READ_ASCII (itm_off + 0x00 + (index * 0x14)) item
    PATCH_IF ("%item%" STRING_COMPARE_CASE "%tutu_var%misc36" = 0) BEGIN
      READ_SHORT (itm_off + 0x0a + (index * 0x14)) quantity
      READ_LONG  (itm_off + 0x10 + (index * 0x14)) flags
      PATCH_IF ((quantity < 2) AND ((flags & BIT3) = 0)) BEGIN // only one and droppable
        SET pearl = 1
        SET index = itm_num // kill loop
      END  
    END
  END
  PATCH_IF pearl = 1 BEGIN 
    READ_LONG 0x2c4 fx_off
    READ_LONG 0x2c8 fx_num
    READ_BYTE 0x033 fx_type
    INSERT_BYTES fx_off (0x30 + (0xd8 * fx_type)) // insert an effect
    WRITE_SHORT (fx_off        + (0x08 * fx_type)) 146 // cast spell
    WRITE_BYTE  (fx_off + 0x02 + (0x0a * fx_type))   1 // target: self
    WRITE_LONG  (fx_off + 0x08 + (0x10 * fx_type))   1 // cast instantly
    WRITE_BYTE  (fx_off + 0x0c + (0x10 * fx_type))   1 // instant/perm
    WRITE_BYTE  (fx_off + 0x12 + (0x12 * fx_type)) 100 // prob1
    WRITE_ASCII (fx_off + 0x14 + (0x14 * fx_type)) ~cdbpearl~
    WRITE_LONG 0x2c8 (fx_num + 1) // update num effects
    PATCH_FOR_EACH offset IN 0x2a0 0x2a8 0x2b0 0x2b8 0x2bc BEGIN // update other offsets for new effect
      READ_LONG offset curr_off
      PATCH_IF (fx_off <= curr_off) BEGIN
        WRITE_LONG offset (THIS + (0x30 + (0xd8 * fx_type)))
      END
    END
  END
  BUT_ONLY  
    
COPY ~thecalling/spl/cdbpearl.spl~ ~override~
  LPF ALTER_EFFECT INT_VAR match_opcode = 112 STR_VAR resource = EVAL ~%tutu_var%misc36~ END
  
EXTEND_BOTTOM ~%Lighthouse_BlackAlaricsCave_BCS%.bcs~ ~thecalling/baf/pearl.baf~    EVALUATE_BUFFER // guarantee a black pearl in sil's cave
 
ACTION_FOR_EACH bam IN cmisc5c cmisc5k cmisc7p imisc5k imisc5z imisc7p BEGIN

  ACTION_IF NOT FILE_EXISTS_IN_GAME ~%bam%.bam~ THEN BEGIN // missing bams from bgee

    COPY ~thecalling/bam/%bam%.bam~ ~override~
  
  END

END

