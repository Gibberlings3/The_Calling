COPY ~thecalling/are/10~ ~override~ // bmp, mos, wed
COPY ~thecalling/bam/flame2n.bam~ ~override~ // a small candle animation for CD5105

// new areas that connect to the gnoll stronghold need to use the platform-specific resref
COPY ~thecalling/are/cd5104.are~ ~override~
     ~thecalling/are/cd5105.are~ ~override~
     ~thecalling/are/cd5106.are~ ~override~
     ~thecalling/are/cd5107.are~ ~override~
     ~thecalling/are/cd5108.are~ ~override~
     ~thecalling/are/cd5109.are~ ~override~
  LPF ALTER_AREA_REGION STR_VAR region_name = to_gnoll_exterior destination_area = EVAL ~%GnollStronghold%~ END 
  PATCH_IF tutu_gen BEGIN // adjust tutu resource names
    LPF tutuize_items INT_VAR item_number = (SHORT_AT 0x76) item_offset = (LONG_AT 0x78) END
  END  

COPY_EXISTING ~cd5104.are~ ~override~
  PATCH_IF tutu_gen BEGIN // adjust tutu resource names
    LPF ALTER_AREA_REGION STR_VAR region_name = Trap1 region_script = EVAL ~%tutu_var%gtar~ END
    LPF ALTER_AREA_REGION STR_VAR region_name = Trap2 region_script = EVAL ~%tutu_var%gtar~ END
    LPF ALTER_AREA_REGION STR_VAR region_name = Trap3 region_script = EVAL ~%tutu_var%gtfb~ END
    LPF ALTER_AREA_REGION STR_VAR region_name = Trap4 region_script = EVAL ~%tutu_var%gtar~ END
    LPF ALTER_AREA_ACTOR STR_VAR actor_name = dog cre_file = EVAL ~%tutu_var%dogwi~ END
    LPF ALTER_AREA_ACTOR STR_VAR actor_name = spider cre_file = EVAL ~%tutu_var%spidgi~ END  
  END  
  
COPY_EXISTING ~cd5105.are~ ~override~
  LPF ALTER_AREA_REGION STR_VAR region_name = to_gnoll_exterior2 destination_area = EVAL ~%GnollStronghold%~ END 
  PATCH_IF tutu_gen BEGIN // adjust tutu resource names
    LPF ALTER_AREA_ACTOR STR_VAR actor_name = "Actor 1" cre_file = EVAL ~%tutu_var%gnoll~ END
    LPF ALTER_AREA_ACTOR STR_VAR actor_name = "Actor 26" cre_file = EVAL ~%tutu_var%flind~ END
    LPF ALTER_AREA_CONTAINER STR_VAR container_name = Container002 container_script  = EVAL ~%tutu_var%ctar~ END
    LPF ALTER_AREA_CONTAINER STR_VAR container_name = Container004 container_script  = EVAL ~%tutu_var%ctlb~ END
    LPF ALTER_AREA_CONTAINER STR_VAR container_name = Container039 container_script  = EVAL ~%tutu_var%ctar~ END
    READ_LONG 0xc0 rest_off
    FOR (index = 0 ; index < 10 ; ++index) BEGIN 
      READ_ASCII   (rest_off + 0x48 + (index * 0x04)) mon (7)
      WRITE_ASCIIE (rest_off + 0x48 + (index * 0x04)) ~_%mon%~ #8 // can do this lazily since the fields are known
    END
  END ELSE
  PATCH_IF game_is_eet BEGIN
    READ_LONG 0xc0 rest_off
    FOR (index = 0 ; index < 10 ; ++index) BEGIN 
      WRITE_LONG (rest_off + 0x20 + (index * 0x04)) THIS + 200000 // update rest spawn strings 
    END
  END
// torches and candles
  PATCH_DEFINE_ARRAY x_coord BEGIN 303  439  1382 1433 1485 1520 1689 1698 1703 1693 2020 2025 2033 2029 2284 2289 2298 2294 2682 1842 1948 1721 1494 1298 1355 1384 570  723  835  950  END
  PATCH_DEFINE_ARRAY y_coord BEGIN 1565 1044 381  350  321  233  451  448  455  458  635  630  632  639  875  869  873  878  1420 1404 1482 1702 1632 2246 2296 2296 1713 1643 1724 1808 END
  PATCH_PHP_EACH x_coord AS index => x BEGIN
  	LPF fj_are_structure
  	INT_VAR
  	  fj_loc_x = $x_coord("%index%")
  	  fj_loc_y = $y_coord("%index%")
  	  fj_schedule = 0b111111111111111111111111 //Hours 
  	  fj_flags = 0b00000000000000000001000001100011	// Visible, blend colours, not covered by wall, don't remove in combat
  	  STR_VAR
  	  fj_structure_type = animation
  	  fj_name = FLAME2N
  	  fj_bam_resref = FLAME2N //bgrd
  	END
  END
  CLEAR_ARRAY x_coord
  CLEAR_ARRAY y_coord
  
  PATCH_DEFINE_ARRAY x_coord BEGIN 385 609 1202 1382 1248 1312 555  673  988 1121 1227 1443 1646 1955 1936 2038 2282 2234 2358 2437 2544 2547 2866 3026 3352 2209 2470 2530 2788 2458 2290 1947 2319 2109 1972 1806 1589 1918 1765 1628 1461 1285 1104 1257 1427 1649 1836 921  1091 1315 1501 586  757  980  1166 630  530  199  1159 1051 1162 1383 1501 END
  PATCH_DEFINE_ARRAY y_coord BEGIN 778 824 363  491  285  239  1154 1071 850 756  679  527  589  418  794  865  649  1004 1093 1276 833  1198 1591 1487 1628 1898 1705 1588 1757 2222 2165 2149 1518 1703 1800 1917 2070 1157 1266 1362 1480 1605 1734 831  709  764  896  1070 948  1002 1134 1307 1186 1241 1373 1576 1499 1399 1879 2101 2024 2021 2105 END
  PATCH_PHP_EACH x_coord AS index => x BEGIN
  	LPF fj_are_structure
  	INT_VAR
  	  fj_loc_x = $x_coord("%index%")
  	  fj_loc_y = $y_coord("%index%")
  	  fj_schedule = 0b111111111111111111111111 //Hours 
  	  fj_flags = 0b00000000000000000001000001100011	// Visible, blend colours, not covered by wall, don't remove in combat
  	  STR_VAR
  	  fj_structure_type = animation
  	  fj_name = FIREBRN
  	  fj_bam_resref = FIREBRN //bgrd
  	END
  END
  CLEAR_ARRAY x_coord
  CLEAR_ARRAY y_coord
  
  PATCH_DEFINE_ARRAY x_coord BEGIN 733 1014 END
  PATCH_DEFINE_ARRAY y_coord BEGIN 643 445  END
  PATCH_PHP_EACH x_coord AS index => x BEGIN
  	LPF fj_are_structure
  	INT_VAR
  	  fj_loc_x = $x_coord("%index%")
  	  fj_loc_y = $y_coord("%index%")
  	  fj_schedule = 0b111111111111111111111111 //Hours 
  	  fj_flags = 0b00000000000000000001000001100011	// Visible, blend colours, not covered by wall, don't remove in combat
  	  STR_VAR
  	  fj_structure_type = animation
  	  fj_name = FIRE_4
  	  fj_bam_resref = FIRE_4 //bgrd
  	END
  END
  CLEAR_ARRAY x_coord
  CLEAR_ARRAY y_coord
  
