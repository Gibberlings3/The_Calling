COPY ~thecalling/cre/cd51ch.cre~ ~override~
  SAY NAME1 @10005
  SAY NAME2 @10005
  WRITE_ASCIIE 0x268 ~%tutu_scriptw%tasight~  
  PATCH_IF !opp_palette BEGIN // if using color only available with 1pp/EE
    WRITE_BYTE 0x2e 46
  END  
  ADD_CRE_ITEM ~%bg_rndtre02%~ #0 #0 #0 NONE ~inv~

COPY ~thecalling/cre/cd51gho.cre~ ~override~
  SAY NAME1 @10010
  SAY NAME2 @10010
  WRITE_ASCIIE 0x268 ~%tutu_scriptw%tasight~  

COPY ~thecalling/cre/cd51go.cre~ ~override~
  SAY NAME1 @10006
  SAY NAME2 @10006
  WRITE_ASCIIE 0x268 ~%tutu_scriptw%tasight~  
  ADD_CRE_ITEM ~%bg_rndtre04%~ #0 #0 #0 NONE ~inv~

COPY ~thecalling/cre/cd51gs.cre~ ~override~
  SAY NAME1 @10003
  SAY NAME2 @10003
  PATCH_IF !enhanced_edition BEGIN // no shaman, so delete shaman-only spells and give generic druid AI script
    WRITE_BYTE 0x273 11 // class: druid
    LPF DELETE_EFFECT INT_VAR match_opcode = 251 END
    REMOVE_MEMORIZED_SPELL sppr150 sppr250 sppr350
    REMOVE_KNOWN_SPELL     sppr150 sppr250 sppr350  
    PATCH_IF !opp_palette BEGIN // if using color only available with 1pp/EE
      WRITE_BYTE 0x31 58
    END                   	   
  END  
  ADD_CRE_ITEM ~%bg_rndtre02%~ #0 #0 #0 NONE ~inv~

COPY ~thecalling/cre/cd51gw.cre~ ~override~
  SAY NAME1 @10002
  SAY NAME2 @10002
  WRITE_ASCIIE 0x268 ~%tutu_scriptw%tasight~  
  ADD_CRE_ITEM ~%bg_rndtre02%~ #0 #0 #0 NONE ~inv~

COPY ~thecalling/cre/cd51gz.cre~ ~override~
