COPY_EXISTING ~cd51sol1.cre~ ~override/cd51shop.cre~
  SAY NAME1 @10172
  SAY NAME2 @10172
  WRITE_ASCII 0x280 cd51shop  #32// dv
  WRITE_ASCII 0x2cc cd51shop // dlg

OUTER_FOR (index = 1 ; index < 7 ; ++index) BEGIN

COPY_EXISTING ~cd51sol1.cre~ ~override/cd51ded%index%.cre~ // dead soldiers
  WRITE_LONG 0x10 (THIS BOR BIT2) // add perm corpse flag
  WRITE_LONG 0x20 (THIS BOR BIT11) // add dead flag
  WRITE_SHORT 0x26 0 // current HP
  WRITE_ASCIIE 0x280 ~cd51ded%index%~ #32 // dv
  ADD_CRE_ITEM ~%bg_rndtre04%~ #0 #0 #0 NONE ~inv~
    
END
  
  
