/////                                                  \\\\\
///// Thief - Expanded Narlen Stuff                    \\\\\
/////                                                  \\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\

BEGIN @80000 DESIGNATED 80
GROUP @8
REQUIRE_PREDICATE GAME_IS ~bgee tutu tutu_totsc bgt eet~ @0
REQUIRE_PREDICATE ("%LANGUAGE%" STRING_COMPARE_CASE "english" = 0) @5 // skip if translation doesn't exist
LABEL ~cd_the_calling_thief~

/*

CDThiefCalling

fail values:
-1 rejected Bdharlan's quest
-2 did not accept/complete mysterious woman's quest

1 Bdharlan has spawned
2 agreed to help Bdharlan
3 followed Bdharlan to the hag's area via cutscene, prompts hag dialogue
4 hag dialogue complete, ambush sprung
 - interlude for Narlen's quests, need NarlenMove>6 to proceed -
4 & NarlenMove>6 - spawn mysterious woman
5 prompt MW to speak
6 move MW to gate, spawn Mallandrea in undercellars - Xamm spawns here or for any >5 value
7 Mallandrea spawned
8 spoke with Mallandrea (all outcomes)
9 fought xamm
10 xamm left peacfully
11 xamm pushed into river
12 reported xamm's demise to MW, quest complete

*/

/////                                                  \\\\\
///// copies, preamble                                 \\\\\
/////                                                  \\\\\

ADD_JOURNAL TITLE (@80151) @80152 @80153 @80154 @80155 // A Job for Bdharlan
ADD_JOURNAL TITLE (@80156) @80157 @80158 @80159 @80160 @80161 @80162 @80163 // A Job for the Mystery Woman

COPY ~thecalling/bam/cd09amu%enhanced_edition%.bam~ ~override/cd09amu.bam~
     ~thecalling/bam/cd09clu%enhanced_edition%.bam~ ~override/cd09clu.bam~
     ~thecalling/bam/cd09dag%enhanced_edition%.bam~ ~override/cd09dag.bam~
     ~thecalling/bam/cd09pc%enhanced_edition%.bam~  ~override/cd09pc.bam~ 
     ~thecalling/bam/cd09rin%enhanced_edition%.bam~ ~override/cd09rin.bam~

LAF HANDLE_AUDIO STR_VAR audio_path = ~thecalling/audio/80~ oggdec_path = ~thecalling/audio~ sox_path = ~thecalling/audio~ END // ambients, audio

/////                                                  \\\\\
///// area stuff                                       \\\\\
/////                                                  \\\\\

COPY ~thecalling/are/80~ ~override~ // bmp, mos, wed

// new areas that connect to the gnoll stronghold need to use the platform-specific resref
COPY ~thecalling/are/cd0902.are~ ~override~
  PATCH_IF !game_is_bgee BEGIN // travel regions set to ar099 by default; must adjust for eet/bgt/tutu
    PATCH_IF game_is_bgt BEGIN SPRINT exit "Exit8300" END ELSE BEGIN SPRINT exit "Exit1400" END 
    LPF ALTER_AREA_REGION STR_VAR region_name = CD_travelN destination_area = EVAL ~%WyrmsCrossing%~ entrance_name = EVAL ~%exit%~ END 
    LPF ALTER_AREA_REGION STR_VAR region_name = CD_travelS destination_area = EVAL ~%WyrmsCrossing%~ entrance_name = EVAL ~%exit%~ END 
    LPF ALTER_AREA_REGION STR_VAR region_name = CD_travelE destination_area = EVAL ~%WyrmsCrossing%~ entrance_name = EVAL ~%exit%~ END 
    LPF ALTER_AREA_REGION STR_VAR region_name = CD_travelW destination_area = EVAL ~%WyrmsCrossing%~ entrance_name = EVAL ~%exit%~ END 
    PATCH_IF tutu_gen BEGIN // adjust tutu resource names
      LPF tutuize_items INT_VAR item_number = (SHORT_AT 0x76) item_offset = (LONG_AT 0x78) END
    END  
  END
  // turn the area in an extended nightmap
  PATCH_IF SOURCE_SIZE > 0x11b BEGIN // Valid size check
    PATCH_IF (((BYTE_AT 0x48) << 7) & BIT7) BEGIN // Toggle only outdoor areas
      WRITE_BYTE 0x48 (THIS | BIT6 | BIT1 | BIT2) // Toggle extended night flag (BIT6) and day/night flag (BIT1) and weather flag (BIT2)
	  GET_OFFSET_ARRAY animations ARE_V10_ANIMATIONS		// turn off creatures at night time
      PHP_EACH animations AS i => off BEGIN
	    READ_ASCII off + 0x28 cre_resref
	    TO_LOWER cre_resref
	    PATCH_IF VARIABLE_IS_SET $turn_off_at_night("%cre_resref%") BEGIN
	      WRITE_LONG off + 0x24 0x1ffe0 // 05:30 to 17:29
	    END
	  END
	END
  END
  

ACTION_IF enhanced_edition BEGIN

  // add new areas to the console menu listing
  COPY_EXISTING ~bgee.lua~ ~override~
    SPRINT cd0902_descript @80007 // do it this way so that the entries can also be translated
    REPLACE_TEXTUALLY ~\({"%WyrmsCrossingTenyasHouse%",.+},\)~ ~\1
	{"cd0902", "%cd0902_descript%"},~
  
  COPY ~thecalling/tilesets/80~ ~override~                       // new area tilesets/pvrz
  
END ELSE BEGIN

  INCLUDE ~thecalling/lib/a7_tools.tpa~ // tile2ee
  LAF HANDLE_TILE2EE INT_VAR quality_v1 = 9 STR_VAR input_path = ~thecalling/tilesets/80~ END // new area tilesets/pvrz

END

