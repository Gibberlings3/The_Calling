  PATCH_IF tutu_gen BEGIN // adjust tutu resource names
    LPF ALTER_AREA_ACTOR STR_VAR actor_name = "Actor 1" cre_file = EVAL ~%tutu_var%flind~ END
    LPF ALTER_AREA_REGION STR_VAR region_name = Trap1 region_script = EVAL ~%tutu_var%gtar8~ END
  END  
  
