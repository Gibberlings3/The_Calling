    fj_loc_y = 1362
    fj_vertex_0 = 2143 + (1352 << 16)
    fj_vertex_1 = 2103 + (1413 << 16)
    fj_vertex_2 = 2197 + (1459 << 16)
    fj_vertex_3 = 2253 + (1403 << 16)
  STR_VAR
    fj_structure_type = region
