/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\

BEGIN @10000 DESIGNATED 10
GROUP @8
REQUIRE_PREDICATE GAME_IS ~bgee tutu tutu_totsc bgt eet~ @0
REQUIRE_PREDICATE (("%LANGUAGE%" STRING_COMPARE_CASE "english" = 0) OR 
                   ("%LANGUAGE%" STRING_COMPARE_CASE "german" = 0)) @5 // skip if translation doesn't exist
LABEL ~cd_the_calling_fighter~

/* CDGnollQuest

1 - spoken with Captain Stilind, agreed to help
2 - killed the thre gnolls and reported back to Stilind
3 - Stilind turns off the spawn points and moves deeper into the fortress
4 - stilind asks party to get supplies from nashkel
5 - party gives supplies to stilind, cutscene
6 - custscene ends, reinforcements have arrived
7 - post-cutscene dialogue complete
8 - asked to clear out ghost
9 - reported defeat of ghost to stilind, quest complete
*/

/////                                                  \\\\\
///// preamble                                         \\\\\
/////                                                  \\\\\

OUTER_SET opp_palette = 0
ACTION_IF enhanced_edition OR (MOD_IS_INSTALLED ~1pp.tp2~ 102) OR (MOD_IS_INSTALLED ~1pp.tp2~ 102) BEGIN OUTER_SET opp_palette = 1 END
						
ADD_JOURNAL TITLE (@10173) @10174 @10175 @10176 @10177 @10178 @10179 @10180 @10181 @10182 @10183 @10184 @10185 @10186

