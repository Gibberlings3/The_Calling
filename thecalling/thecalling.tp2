BEGIN @50000 DESIGNATED 50
GROUP @8
REQUIRE_PREDICATE GAME_IS ~bgee tutu tutu_totsc bgt eet~ @0
REQUIRE_PREDICATE ((MOD_IS_INSTALLED ~thecalling.tp2~ 10) OR
                   (MOD_IS_INSTALLED ~thecalling.tp2~ 20) OR
                   (MOD_IS_INSTALLED ~thecalling.tp2~ 60) OR
                   (MOD_IS_INSTALLED ~thecalling.tp2~ 61) OR
                   (MOD_IS_INSTALLED ~thecalling.tp2~ 70)) @6 // skip if no callings installed
LABEL ~cd_the_calling_cheats~

EXTEND_BOTTOM ~baldur.bcs~ ~thecalling/baf/cheat2.baf~

