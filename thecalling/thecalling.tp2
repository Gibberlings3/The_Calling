LAF HANDLE_AUDIO STR_VAR audio_path = ~thecalling/audio/10~ oggdec_path = ~thecalling/audio~ sox_path = ~thecalling/audio~ END // ambients, audio

ACTION_IF !enhanced_edition BEGIN

  APPEND ~tooltip.2da~ ~cd51sta 15529 12033 -1
cd51rew 14034 -1 -1~                           // add tooltip for Staff of Corrosive Thoughts +1, Cloak of the Regent-Warrior
  COPY ~thecalling/spl/cd51rew.spl~ ~override~ // provides fighter-only 19 CHR for Cloak of the Regent-Warrior
  COMPILE ~thecalling/baf/cd5104.baf~          // smoke ambients look terrible in original, disable until fixed
       
END  

// the %enhanced_edition% is used to grab one-cycle item icons (ee) or 2-cycle (non-EE)
COPY ~thecalling/bam/cd51amu%enhanced_edition%.bam~ ~override/cd51amu.bam~ // icon, Amulet of Dark Misfortune
     ~thecalling/bam/cd51arc%enhanced_edition%.bam~ ~override/cd51arc.bam~ // description image, Broken Spirit Arrow +1
     ~thecalling/bam/cd51ari%enhanced_edition%.bam~ ~override/cd51ari.bam~ // icon, Broken Spirit Arrow +1
     ~thecalling/bam/cd51bel%enhanced_edition%.bam~ ~override/cd51bel.bam~ // icon, Belt of Omens
     ~thecalling/bam/cd51cha%enhanced_edition%.bam~ ~override/cd51cha.bam~ // icon, Chain of Primitive Respect +1
     ~thecalling/bam/cd51clo%enhanced_edition%.bam~ ~override/cd51clo.bam~ // icon, Cloak of Shape Stability
     ~thecalling/bam/cd51key%enhanced_edition%.bam~ ~override/cd51key.bam~ // icon, Primitive Key
     ~thecalling/bam/cd51rew%enhanced_edition%.bam~ ~override/cd51rew.bam~ // icon, Cloak of the Regent-Warrior
     ~thecalling/bam/cd51sec%enhanced_edition%.bam~ ~override/cd51sec.bam~ // icon, Yeenoghu's Burning Flesh
     ~thecalling/bam/cd51smk.bam~                   ~override~             // ambient animation, smoke
     ~thecalling/bam/cd51hal.bam~                   ~override~             // chimera's halberd icon
     ~thecalling/bam/cd51halc.bam~                  ~override~             // chimera's halberd cold mode
     ~thecalling/bam/cd51hale.bam~                  ~override~             // chimera's halberd electric mode
     ~thecalling/bam/cd51half.bam~                  ~override~             // chimera's halberd fire mode
     ~thecalling/bam/cd51sta%enhanced_edition%.bam~ ~override/cd51sta.bam~ // icon, Staff of Corrosive Thoughts +1
     ~thecalling/bam/cd51sup%enhanced_edition%.bam~ ~override/cd51sup.bam~ // icon, Medical Supplies
     ~thecalling/eff/cd51rew%enhanced_edition%.eff~ ~override/cd51rew.eff~ // provides fighter-only 19 CHR for Cloak of the Regent-Warrior

COPY ~thecalling/sto/cd51shop.sto~ ~override~
  SAY 0x0c @10172
  PATCH_IF tutu_gen BEGIN // adjust tutu resource names
    LPF tutuize_items INT_VAR item_number = (LONG_AT 0x38) item_offset = (LONG_AT 0x34) item_length = 0x1c END
  END  

