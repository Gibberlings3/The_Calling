  COPY_EXISTING ~cd09thi.cre~ ~override~
                ~cd09hag.cre~ ~override~
                //~cd09spc.cre~ ~override~ // uses animation defaults
                ~cd09th2.cre~ ~override~
                ~cd09fri.cre~ ~override~ // no items
                ~cd09man.cre~ ~override~ 
    LPM eetize_soundsets
    BUT_ONLY

END

