COPY ~thecalling/cre/cd09thi.cre~ ~override~
  SAY NAME1 @80001
  SAY NAME2 @80001

COPY ~thecalling/cre/cd09hag.cre~ ~override~
  SAY NAME1 @80002
  SAY NAME2 @80002

COPY ~thecalling/cre/cd09spc.cre~ ~override~
  SAY NAME1 @80003
  SAY NAME2 @80003

COPY ~thecalling/cre/cd09th2.cre~ ~override~
  SAY NAME1 @80004
  SAY NAME2 @80004

COPY ~thecalling/cre/cd09fri.cre~ ~override~
  SAY NAME1 @80005
  SAY NAME2 @80005

COPY ~thecalling/cre/cd09man.cre~ ~override~
  SAY NAME1 @80006
  SAY NAME2 @80006
  
  
